{
  "name": "nutritioncolours-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "sitemaps": "tsx scripts/generate-xml-sitemaps.ts",
    "check-duplicates": "tsx scripts/check-duplicates.ts",
    "check-thin": "tsx scripts/check-word-count.ts",
    "validate-schema": "node scripts/validate-jsonld.mjs dist",
    "check-orphans": "node scripts/check-orphan-links.mjs dist",
    "check-claims": "tsx scripts/check-claims.ts",
    "build:chunked": "tsx scripts/build-cities.ts",
    "build": "npm run sitemaps && astro build && npm run check-duplicates && npm run check-thin && npm run validate-schema && npm run check-claims",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "lint:fix": "eslint src --ext .ts,.tsx,.astro --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "astro": "astro",
    "freshness": "tsx scripts/generate-content-freshness.ts",
    "add-frontmatter": "node scripts/add-astro-frontmatter.js",
    "ping-indexnow": "tsx scripts/ping-indexnow.ts",
    "deploy": "tsx scripts/deploy-git.ts",
    "build:all": "npm run build && npm run deploy",
    "postbuild": "tsx scripts/verify-meta-alt.ts"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/react": "6.0.1",
    "@google/genai": "^2.10.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.7",
    "astro-og-canvas": "^0.13.0",
    "astro-pagefind": "^2.0.1",
    "d3": "^7.9.0",
    "dompurify": "^3.4.11",
    "framer-motion": "^12.38.0",
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "lucide-react": "^1.23.0",
    "pagefind": "^1.5.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/mdx": "^7.0.3",
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "astro-compressor": "^1.3.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^1.7.0",
    "glob": "^13.0.6",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.0",
    "typescript": "5.8.3",
    "vite": "8.1.4"
  }
}
