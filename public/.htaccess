# NutritionColours — Apache/Hostinger config for the static build.
# Deployed to /public_html/.htaccess (Astro copies public/ to the site root).
# Scope is deliberately minimal + additive: it wires the custom 404 and 301s a
# curated set of plausible/invented paths to real pages. It does NOT rewrite any
# existing valid route. Test on staging before production.

# --- Custom 404 (MRS §7) ----------------------------------------------------
# Serve the designed recovery page instead of Apache's default on any dead URL.
ErrorDocument 404 /404.html

# --- Hallucinated-URL capture (MRS §42.6) -----------------------------------
# LLMs (ChatGPT/Perplexity/Gemini) invent plausible URLs on your domain; users
# also guess short paths. Each line converts a likely-invented/guessed path into
# a 301 to the closest real page, turning the model's imagination into traffic.
#
# HOW TO EXTEND: weekly, grep server logs for 404s whose user-agent or referrer is
# an AI bot/engine (GPTBot, ClaudeBot, PerplexityBot, chatgpt.com, perplexity.ai),
# find the closest real page, and add a `Redirect 301 /invented /real` line below.
#
# All targets below were verified to exist in the build.

# Section shortcuts people/AI guess (we relabeled "Health Topics" as "Diseases")
Redirect 301 /diseases            /knowledge/diseases
Redirect 301 /disease             /knowledge/diseases
Redirect 301 /conditions          /knowledge/diseases
Redirect 301 /condition           /knowledge/diseases
Redirect 301 /herbs               /knowledge/herbs
Redirect 301 /herbs-and-spices    /knowledge/herbs
Redirect 301 /spices              /knowledge/spices
Redirect 301 /glossary            /knowledge
Redirect 301 /blog                /knowledge
Redirect 301 /blogs               /knowledge
Redirect 301 /articles            /knowledge
Redirect 301 /nutrigenomics       /knowledge
Redirect 301 /genomics            /knowledge
Redirect 301 /drug-interactions   /knowledge
Redirect 301 /interactions        /knowledge
Redirect 301 /vegan               /knowledge
Redirect 301 /knowledge-base      /knowledge
Redirect 301 /knowledge/health-topics      /knowledge/diseases
Redirect 301 /knowledge/health-conditions    /knowledge/diseases

# Legacy CamelCase and Spaced Folder Mappings
Redirect 301 "/knowledge/Kidney Diseases" "/knowledge/diseases/kidney-diseases"
Redirect 301 "/knowledge/Cardiovascular Disease" "/knowledge/diseases/cardiovascular-disease"
Redirect 301 "/knowledge/Neurological Disorders" "/knowledge/diseases/neurological-disorders"
Redirect 301 "/knowledge/Endocrine Disorders" "/knowledge/diseases/endocrine-disorders"
Redirect 301 "/knowledge/Respiratory Diseases" "/knowledge/diseases/respiratory-diseases"
Redirect 301 "/knowledge/Malignant Neoplasms" "/knowledge/diseases/malignant-neoplasms"

# Planned classes that don't have their own hub yet — route to the closest live hub.
# NOTE: /foods now exists as a real hub, so it is intentionally NOT redirected here.
Redirect 301 /fruit               /knowledge/fruits
Redirect 301 /fruits              /knowledge/fruits
Redirect 301 /nutrients           /knowledge/nutrient-database
Redirect 301 /recipes-list        /recipes
Redirect 301 /calculators         /tools
Redirect 301 /calculator          /tools

# --- /foods/fruits/* retirement (2026-07-15, round 5) -----------------------
# /knowledge/fruits/... is now canonical (owner decision). These 301s are the
# production-grade redirect; the old Astro pages also carry a meta-refresh +
# canonical tag as defense-in-depth. All 12 targets verified to exist in the build.
Redirect 301 /foods/fruits/mango        /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/mango
Redirect 301 /foods/fruits/banana       /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/banana
Redirect 301 /foods/fruits/guava        /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/guava
Redirect 301 /foods/fruits/papaya       /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/papaya
Redirect 301 /foods/fruits/pomegranate  /knowledge/fruits/berries-aggregate-fruits/aggregate-fruits/pomegranate
Redirect 301 /foods/fruits/amla         /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/amla
Redirect 301 /foods/fruits/apple        /knowledge/fruits/pome-stone-fruits/drupes/apple
Redirect 301 /foods/fruits/watermelon   /knowledge/fruits/melons/watermelons/watermelon
Redirect 301 /foods/fruits/orange       /knowledge/fruits/citrus-fruits/sweet-citrus/orange
Redirect 301 /foods/fruits/jackfruit    /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/jackfruit
Redirect 301 /foods/fruits/pineapple    /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/pineapple
Redirect 301 /foods/fruits/sapota-chikoo /knowledge/fruits/tropical-exotic-fruits/creamy-dense-tropicals/sapota-chikoo
Redirect 301 /foods/fruits              /knowledge/fruits

# Common high-intent disease shortcuts → the canonical condition page
Redirect 301 /diabetes            /condition/diabetes-reversal
Redirect 301 /type-2-diabetes     /condition/diabetes-reversal
Redirect 301 /pcos                /condition/pcod-pcos
Redirect 301 /pcod                /condition/pcod-pcos
Redirect 301 /fatty-liver         /condition/masld
Redirect 301 /masld               /condition/masld
Redirect 301 /insulin-resistance  /condition/insulin-resistance
Redirect 301 /thyroid             /condition/thyroid-dysfunction
Redirect 301 /hypertension        /condition/hypertension

# --- Browser & CDN Caching (LiteSpeed/Apache mod_expires) --------------------
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default caching rule (2 days)
  ExpiresDefault "access plus 2 days"
  
  # HTML/XML files (cache briefly, revalidate frequently)
  ExpiresByType text/html "access plus 4 hours"
  ExpiresByType application/xhtml+xml "access plus 4 hours"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  
  # Static assets - CSS and JS (content-hashed by Astro, safe to cache long-term)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Media assets (images, icons, vectors)
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Font files
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# --- Cache-Control Headers (LiteSpeed/Apache mod_headers) -------------------
<IfModule mod_headers.c>
  # 1. Content-hashed static assets (CSS, JS, Fonts) - cache forever, never revalidate
  <FilesMatch "\.(css|js|woff|woff2|otf|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # 2. Media assets (images, icons) - cache long-term
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # 3. HTML & API responses - cache briefly, must revalidate
  <FilesMatch "\.(html|xml|json)$">
    Header set Cache-Control "max-age=14400, public, must-revalidate"
  </FilesMatch>
</IfModule>
