---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icons from '../components/Icons.astro';
---

<BaseLayout
  title="Page not found | NutritionColours"
  description="The requested page is unavailable. Use the stable site navigation to continue."
  noindex={true}
>
  <article class="mx-auto max-w-3xl px-6 py-20 md:py-28 text-center">
    <div class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-3xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/80 text-emerald-800 dark:text-emerald-300 shadow-xs" aria-hidden="true">
      <svg class="h-12 w-12 text-emerald-700 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C10.9 14.36 12 15 12 15"/>
      </svg>
    </div>

    <div class="inline-flex items-center gap-2 rounded-full border border-stone-300 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300">
      Error 404 · Page Not Found
    </div>

    <h1 class="mt-4 text-4xl md:text-6xl font-black text-emerald-950 dark:text-emerald-50 brand-font tracking-tight leading-[1.08]">
      Page not found
    </h1>

    <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-stone-600 dark:text-stone-400">
      The address may be mistyped, moved, or part of legacy unreviewed drafts permanently withdrawn under our clinical copywriting standards.
    </p>

    <nav aria-label="Recovery navigation" class="mt-10 flex flex-wrap justify-center gap-3 text-sm font-bold">
      <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-6 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors shadow-sm">
        <Icons name="arrow-left" size={16} />
        <span>Return Home</span>
      </a>
      <a href="/search" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        <Icons name="search" size={16} />
        <span>Search library</span>
      </a>
      <a href="/knowledge" class="rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Knowledge directory
      </a>
      <a href="/foods" class="rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Food library
      </a>
      <a href="/contact" class="rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Contact
      </a>
    </nav>
  </article>
</BaseLayout>
