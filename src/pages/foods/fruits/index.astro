---
// RETIRED 2026-07-15 (round 5): the Fruits hub now lives at /knowledge/fruits (owner decision —
// src/content/knowledge/ is canonical, /foods/fruits/* folds into it). Kept as a redirect stub,
// not deleted, so inbound links/bookmarks still land correctly — defense-in-depth alongside the
// .htaccess 301s.
const target = '/knowledge/fruits';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Fruits has moved</title>
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <meta name="robots" content="noindex, follow" />
</head>
<body>
  <p>This page has moved to <a href={target}>{target}</a>.</p>
</body>
</html>
