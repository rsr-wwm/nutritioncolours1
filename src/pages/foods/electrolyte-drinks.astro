---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;
const title = "Electrolyte Drinks – Hydration, Nutrition & Dosage Guide";
const description = "Clinical nutrition details, health benefits, and recommended dosage of electrolyte beverages for optimal hydration.";
---
<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-6 py-16 prose prose-emerald dark:prose-invert">
    <h1>Electrolyte Drinks</h1>
    
    <h3>Clinical Nutrition Details</h3>
    <ul>
      <li><strong>Electrolytes per 250 ml serving:</strong>
        <ul>
          <li>Sodium (Na⁺): 300‑500 mg</li>
          <li>Potassium (K⁺): 100‑200 mg</li>
          <li>Magnesium (Mg²⁺): 30‑50 mg</li>
          <li>Calcium (Ca²⁺): 20‑40 mg</li>
        </ul>
      </li>
      <li><strong>Carbohydrates:</strong> 5‑10 g (typically glucose or maltodextrin) to aid absorption.</li>
      <li><strong>Vitamins:</strong> Small amounts of vitamin C and B‑complex (depends on formulation).</li>
      <li><strong>Osmolality:</strong> 300‑600 mOsm/L, matching physiological range for rapid cellular uptake.</li>
    </ul>

    <h3>Health Benefits</h3>
    <ul>
      <li><strong>Rehydration:</strong> Restores fluid balance after exercise, heat exposure, or illness.</li>
      <li><strong>Electrolyte Homeostasis:</strong> Supports nerve impulse transmission and muscle contraction.</li>
      <li><strong>Performance:</strong> Maintains VO₂ max and reduces perceived exertion during prolonged endurance activities.</li>
      <li><strong>Recovery:</strong> Facilitates glycogen replenishment when combined with carbohydrate source.</li>
    </ul>

    <h3>Recommended Dosage</h3>
    <ul>
      <li><strong>Post‑exercise:</strong> 500‑750 ml within 30 minutes after activity lasting &gt; 60 minutes.</li>
      <li><strong>Daily Hydration:</strong> 250‑500 ml per 2 hours of moderate activity or hot climate exposure, not exceeding 2 L total for most adults.</li>
      <li><strong>Medical Use (e.g., mild dehydration):</strong> 1 L split across 4 doses, each with 250 ml, administered under medical supervision.</li>
      <li><strong>Caution:</strong> Individuals with hypertension or renal impairment should limit sodium intake; consult healthcare provider for personalized dosing.</li>
    </ul>

    <h3>How to Use</h3>
    <ol>
      <li>Chill the beverage to 4‑10 °C for optimal palatability.</li>
      <li>Consume steadily rather than all at once to improve absorption.</li>
      <li>Pair with a balanced meal to aid electrolyte utilization.</li>
    </ol>

    <blockquote>
      <strong>Note:</strong> Electrolyte drinks are classified as a <em>Service</em> in our nutrition catalogue, with <code>areaServed: "World"</code>.
    </blockquote>
  </div>
</BaseLayout>
