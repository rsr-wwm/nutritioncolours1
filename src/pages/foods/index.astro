---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icons from '../../components/Icons.astro';
import BotanicalMotif from '../../components/ui/BotanicalMotif.astro';
import NotifyMeForm from '../../components/NotifyMeForm.astro';
import approvedData from '../../../data/publishing/approved-leaves.json';
import type { ApprovedLeafRegistry } from '../../lib/publishing/approvedLeafTypes';

const approvedFoodCount = (approvedData as ApprovedLeafRegistry).records.filter((leaf) => leaf.pageKind === 'food').length;
const approvedFoods = (approvedData as ApprovedLeafRegistry).records
  .filter((leaf) => leaf.pageKind === 'food')
  .sort((a, b) => a.canonicalName.localeCompare(b.canonicalName));

// Planned categories remain unpublished until reviewed content exists.
const taxonomy = [
  { class: 'fruit', label: 'Fruits', hub: '/knowledge/fruits' },
  { class: 'vegetable', label: 'Vegetables', hub: '/knowledge/vegetables' },
  { class: 'herb', label: 'Herbs', hub: '/knowledge/herbs' },
  { class: 'spice', label: 'Spices', hub: '/knowledge/spices' },
  { class: 'seed', label: 'Seeds', hub: '/foods/seeds' },
  { class: 'grain', label: 'Grains & Millets', hub: '/foods/grains' },
  { class: 'pulse', label: 'Pulses & Legumes', hub: '/foods/pulses' },
  { class: 'oil', label: 'Oils & Healthy Fats', hub: '/foods/oils' },
  { class: 'dairy', label: 'Dairy & Alternatives', hub: '/foods/dairy' },
  { class: 'beverage', label: 'Drinks & Beverages', hub: '/foods/beverages' },
  { class: 'functional', label: 'Functional Foods', hub: '/foods/functional' },
  { class: 'fermented', label: 'Fermented Foods', hub: '/foods/fermented' },
];
---
<BaseLayout
  title="Foods | NutritionColours"
  description="Browse reviewed food references with composition, preparation, safety and evidence boundaries from the NutritionColours library."
  keywords={["food nutrition database", "food composition", "Indian food nutrition"]}
  noindex={approvedFoodCount === 0}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Foods', path: '/foods' },
  ]}
>
  <div class="max-w-6xl mx-auto px-6 py-16 md:py-24 space-y-12">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Foods</li>
      </ol>
    </nav>

    <header class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800 dark:text-emerald-300">
        <BotanicalMotif name="leaf-branch" class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" />
        Food Composition Library
      </div>
      <h1 class="text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">Foods</h1>
      <p class="text-lg text-stone-700 dark:text-stone-300 leading-relaxed border-l-4 border-emerald-500 pl-4">
        The categories below represent structured botanical and nutritional groups. Content remains unavailable until verified composition data, portion sizes, preparation impacts, and clinical citations pass editorial verification.
      </p>
    </header>

    {approvedFoods.length > 0 && (
      <section aria-labelledby="reviewed-foods-heading" class="space-y-6">
        <h2 id="reviewed-foods-heading" class="text-2xl font-black text-emerald-950 dark:text-emerald-100 brand-font">
          Reviewed food references ({approvedFoods.length})
        </h2>
        <ul class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {approvedFoods.map((leaf) => (
            <li>
              <a
                href={leaf.canonicalPath}
                class="card-interactive group block h-full rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 shadow-sm hover:border-emerald-400 dark:hover:border-emerald-600 transition-all"
              >
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 mb-3">
                  Tier 2 Verified
                </span>
                <span class="block text-lg font-black text-emerald-950 dark:text-emerald-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                  {leaf.canonicalName}
                </span>
                <span class="mt-2 block text-sm leading-6 text-stone-600 dark:text-stone-400">
                  {leaf.metaDescription}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Category Taxonomy Grid -->
    <section aria-labelledby="categories-heading" class="space-y-6">
      <h2 id="categories-heading" class="text-2xl font-black text-emerald-950 dark:text-emerald-100 brand-font">
        Food categories
      </h2>
      <div class="grid grid-cols-1 min-[360px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {taxonomy.map((t) => (
          <div class="card-interactive rounded-2xl border border-stone-200 dark:border-stone-800/80 bg-stone-50/70 dark:bg-stone-900/60 p-5 flex flex-col justify-between">
            <div>
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-400 mb-3">
                <Icons name={t.class} size={20} />
              </span>
              <span class="block text-base font-black text-stone-800 dark:text-stone-200">{t.label}</span>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-1.5">
              <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-stone-500 dark:text-stone-400">Under Review</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Worked example callout card -->
    <div class="rounded-2xl border border-emerald-200/90 dark:border-emerald-800/80 bg-emerald-50/60 dark:bg-emerald-950/30 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Published Reference Preview</span>
        <p class="text-sm text-stone-700 dark:text-stone-300">
          Want to see how an evidence-gated reference looks once verified with human trial citations?
        </p>
      </div>
      <a href="/knowledge/circadian-nutrition" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-5 py-2.5 text-xs font-bold text-white hover:bg-emerald-800 dark:hover:bg-emerald-600 transition-colors whitespace-nowrap self-start sm:self-center shadow-xs">
        <span>Circadian Nutrition Guide</span>
        <Icons name="arrow-right" size={14} />
      </a>
    </div>

    <NotifyMeForm topic="the food directory" />

    <!-- Editorial Assurance Footer Note -->
    <aside class="rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 md:p-8 text-sm text-stone-600 dark:text-stone-400 space-y-2">
      <h2 class="font-bold text-stone-900 dark:text-stone-100">Editorial standard notice</h2>
      <p>
        NutritionColours food profiles reference official nutritional composition tables and peer-reviewed biochemical analyses. Entries do not contain automated or unverified health claims.
      </p>
    </aside>
  </div>
</BaseLayout>
