---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = true;
const title = "Green Tea – Benefits, Dosage & Nutrition";
const description = "Clinical nutrition details, health benefits, and recommended dosage of green tea.";
---
<div data-ai-answer="true">
<BaseLayout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-6 py-16 prose prose-emerald dark:prose-invert">
    <h1>Green Tea</h1>
    
    <h3>Clinical Nutrition Details</h3>
    <ul>
      <li><strong>Caffeine:</strong> 20‑40 mg per 8 oz cup (≈ 0.25 mg/g).</li>
      <li><strong>Catechins (EGCG):</strong> 90‑140 mg per cup; potent antioxidant.</li>
      <li><strong>L‑theanine:</strong> 5‑8 mg per cup; promotes relaxation without drowsiness.</li>
      <li><strong>Vitamins & Minerals:</strong> Trace amounts of vitamin C, manganese, potassium.</li>
    </ul>

    <h3>Health Benefits</h3>
    <ul>
      <li><strong>Cardiovascular:</strong> Improves endothelial function; modest reduction in LDL‑cholesterol.</li>
      <li><strong>Metabolic:</strong> Boosts resting metabolic rate by ~3‑4 %; may aid weight management.</li>
      <li><strong>Neuroprotective:</strong> EGCG and L‑theanine support cognition, reduce risk of mild cognitive impairment.</li>
      <li><strong>Cancer‑preventive:</strong> Laboratory evidence of inhibition of proliferation in breast, prostate, and colorectal cell lines.</li>
    </ul>

    <h3>Recommended Dosage</h3>
    <ul>
      <li><strong>General wellness:</strong> 2–3 cups (250‑350 ml each) per day.</li>
      <li><strong>Therapeutic use (e.g., weight management):</strong> Up to 5 cups daily, divided across meals, not exceeding 600 ml total caffeine.</li>
      <li><strong>Caution:</strong> Individuals sensitive to caffeine should limit to ≤ 1 cup/day; avoid high‑dose extracts (&gt; 800 mg EGCG) due to liver toxicity risk.</li>
    </ul>

    <h3>How to Prepare</h3>
    <ol>
      <li>Heat water to 70‑80 °C (not boiling).</li>
      <li>Steep 2 g of loose leaf tea for 2‑3 minutes.</li>
      <li>Remove leaves; enjoy plain or with a splash of lemon.</li>
    </ol>

    <blockquote>
      <strong>Note:</strong> Green tea is a <em>Service</em>‑type offering in our nutrition catalogue; it serves a global audience (areaServed: "World").
    </blockquote>
  </div>
</BaseLayout>
</div>
