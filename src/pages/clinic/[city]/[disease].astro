---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icons from '../../../components/Icons.astro';
import { LocalDirectory as ClinicClientPage } from '../../../components/LocalDirectory';
import { LOCATIONS_DATA } from '../../../lib/locationsData';
import { INTERNATIONAL_COUNTRIES } from '../../../lib/internationalData';
import { TOPICS } from '../../../data/topics';
import { getNearestLocations } from '../../../lib/geoUtils';
import { findEntityUrl, getRecipesForLocation } from '../../../lib/seo/autoLinker';
import RelatedLeaves from '../../../components/RelatedLeaves.astro';

export async function getStaticPaths() {
  const targetDiseases = ['diabetes-reversal', 'pcos-balance', 'fatty-liver-reversal', 'thyroid-optimization', 'hypertension-management'];

  // Support for Chunked Static Builder (Option B)
  // We can pass CHUNK_INDEX and CHUNK_SIZE via env vars to build a specific slice of the 50k cities
  const chunkIndex = parseInt(process.env.CHUNK_INDEX || '0', 10);
  const chunkSize = parseInt(process.env.CHUNK_SIZE || '150', 10); // default to top 150 if not chunking

  const sortedIndianLocations = [...LOCATIONS_DATA].sort((a, b) => (b.population || 0) - (a.population || 0));
  
  // Calculate the slice for this chunk
  const startIndex = chunkIndex * chunkSize;
  const endIndex = startIndex + chunkSize;
  const currentChunkHubs = sortedIndianLocations.slice(startIndex, endIndex).map(l => l.city.toLowerCase().replace(/[^a-z0-9]/g, '-'));
  
  const intlHubs = chunkIndex === 0 ? ['london', 'new-york-city', 'dubai'] : [];
  const legacyHubs = chunkIndex === 0 ? ['mumbai', 'delhi', 'bangalore'] : [];
  
  const targetCities = [...new Set([...currentChunkHubs, ...intlHubs, ...legacyHubs])].filter(Boolean);

  const paths: any[] = [];
  targetCities.forEach(city => {
    targetDiseases.forEach(disease => {
      paths.push({
        params: { city, disease }
      });
    });
  });
  return paths;
}

const { city, disease } = Astro.params;

const cityLabel = city?.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) || '';

// Resolve location details from both Indian and International databases
const cityLocations = [
  ...LOCATIONS_DATA.filter(l => {
    const normLoc = l.city.toLowerCase().replace(/[^a-z0-9]/g, '');
    const normParam = city?.toLowerCase().replace(/[^a-z0-9]/g, '') || '';
    return normLoc.startsWith(normParam) || normParam.startsWith(normLoc);
  }),
  ...INTERNATIONAL_COUNTRIES.filter(l => {
    const normLoc = l.city.toLowerCase().replace(/[^a-z0-9]/g, '');
    const normParam = city?.toLowerCase().replace(/[^a-z0-9]/g, '') || '';
    return normLoc.startsWith(normParam) || normParam.startsWith(normLoc);
  })
];

let loc = cityLocations[0];
let isInternational = false;
let regionLabel = '';

if (!loc) {
  const isIntlCity = ['london', 'new-york-city', 'dubai'].includes(city || '');
  isInternational = isIntlCity;
  
  if (city === 'delhi') {
    regionLabel = 'Delhi NCR';
  } else if (city === 'london') {
    regionLabel = 'United Kingdom';
  } else if (city === 'new-york-city') {
    regionLabel = 'United States';
  } else if (city === 'dubai') {
    regionLabel = 'United Arab Emirates';
  } else {
    regionLabel = isIntlCity ? 'International' : 'India';
  }

  loc = {
    city: cityLabel,
    state: regionLabel,
    timezone: isIntlCity ? 'UTC' : 'Asia/Kolkata (IST, UTC+5:30)',
    currency: isIntlCity ? (city === 'london' ? 'GBP' : city === 'dubai' ? 'AED' : 'USD') : 'INR (₹, Indian Rupee)',
    dialingCode: isIntlCity ? (city === 'london' ? '+44' : city === 'dubai' ? '+971' : '+1') : '+91',
    healthIssues: ['Type 2 Diabetes', 'PCOD/PCOS', 'Fatty Liver (MASLD)', 'Hypertension', 'Thyroid Dysregulation'],
    localFruits: isIntlCity ? ['Apples', 'Berries'] : ['Pomegranate', 'Papaya'],
    localVegetables: isIntlCity ? ['Broccoli', 'Kale'] : ['Okra', 'Spinach'],
    weather: isIntlCity ? 'Temperate climate' : 'Monsoonal climate',
    regionalDeficiencyRisk: isIntlCity ? 'Vitamin D3' : 'Vitamin D3 & B12',
    localProduceSynergy: 'Ceylon Cinnamon and seasonal organic vegetables',
    clinicalTargetBiomarker: 'HbA1c & Fasting Insulin',
    population: isIntlCity ? 8000000 : 500000,
    commonStaples: 'Processed carbohydrates and seed oils',
    regionalStapleAlternative: 'High-fiber ancestral grains and cold-pressed lipids',
    circadianChallenge: 'Modern indoor lighting and extended evening eating windows',
    microclimateMetabolicImpact: 'Seasonal temperature variations impacting basal metabolic rate and hydration needs',
    localTherapeuticSpice: 'Turmeric'
  } as any;
} else {
  regionLabel = (loc as any).state || 'India';
  isInternational = !!(loc as any).country;
}

const nearestHubs = loc ? getNearestLocations(loc.city, regionLabel, isInternational) : [];
const localRecipes = loc ? getRecipesForLocation(loc as any) : [];

// Resolve disease details
const matchedTopic = TOPICS.find(t => t.id === disease);
const diseaseLabel = matchedTopic ? matchedTopic.title : disease?.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase()) || '';

// Format Population nicely
const formatPop = (num: number) => num > 1000000 ? (num/1000000).toFixed(1) + ' Million' : num.toLocaleString();

// Generate Smart Cross-Links for Deficiencies and Spices
const deficiencyUrl = loc.regionalDeficiencyRisk ? findEntityUrl(loc.regionalDeficiencyRisk) : null;
const spiceUrl = loc.localTherapeuticSpice ? findEntityUrl(loc.localTherapeuticSpice) : null;

// Set Edge-Level Caching headers
Astro.response.headers.set('Cache-Control', 'public, max-age=86400, s-maxage=604800, stale-while-revalidate=3600');

const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');

// Dynamic MedicalWebPage schema targeting the localized disease consultation service
const clinicSchema = loc && matchedTopic ? {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "@id": `${SITE_URL}/clinic/${city}/${disease}#page`,
  "url": `${SITE_URL}/clinic/${city}/${disease}`,
  "name": `${diseaseLabel} Specialist & Nutrition Program in ${cityLabel} | NutritionColours`,
  "description": `Get specialized clinical circadian nutrition consultations for ${diseaseLabel} in ${cityLabel}, ${regionLabel}. Direct guidance by Dr. Shilpa Thakur and our metabolic care team.`,
  "about": {
    "@type": "MedicalCondition",
    "name": diseaseLabel,
    "description": matchedTopic.shortDesc || matchedTopic.solution
  },
  "subjectOf": {
    "@type": "MedicalWebPage",
    "@id": `${SITE_URL}/topic/${disease}#page`,
    "url": `${SITE_URL}/topic/${disease}`,
    "name": `Comprehensive Guide on ${diseaseLabel}`
  },
  "mainEntity": {
    "@type": "Service",
    "name": `Circadian Nutrition Optimization for ${diseaseLabel}`,
    "provider": { 
      "@type": "MedicalOrganization",
      "@id": `${SITE_URL}/#organization`,
      "name": "NutritionColours",
      "medicalSpecialty": "Dietetics"
    },
    "availableChannel": {
      "@type": "ServiceChannel",
      "serviceUrl": SITE_URL,
      "serviceLocation": {
        "@type": "Place",
        "name": "Online / Virtual Care"
      }
    },
    "areaServed": {
      "@type": "City",
      "name": cityLabel,
      "containedInPlace": { "@type": isInternational ? "Country" : "State", "name": regionLabel }
    }
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "xPath": [
      "//*[@itemprop='abstract']",
      "//h1"
    ]
  },
  "publisher": { "@id": `${SITE_URL}/#organization` }
} : null;

// AEO / AIO: FAQPage Schema specifically designed for RAG bots and Search AI Overviews
const faqSchema = loc && matchedTopic ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How does the weather in ${cityLabel} affect ${diseaseLabel}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${loc.weather}. ${loc.microclimateMetabolicImpact || 'This regional climate can influence basal metabolic rate and hydration needs, requiring specific nutritional adjustments.'}`
      }
    },
    {
      "@type": "Question",
      "name": `What are the regional dietary alternatives for managing ${diseaseLabel} in ${cityLabel}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Instead of relying on common staples like ${loc.commonStaples}, our protocol integrates ${loc.regionalStapleAlternative} specifically synergized with ${loc.localTherapeuticSpice}.`
      }
    },
    {
      "@type": "Question",
      "name": `What is the primary circadian challenge for patients in ${cityLabel}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": loc.circadianChallenge || 'Erratic sleep patterns and unaligned meal timings disrupt the central clock.'
      }
    }
  ]
} : null;
---
<div data-ai-answer="true">
<BaseLayout
  title={`Remote ${diseaseLabel} Specialist Serving ${cityLabel} | NutritionColours`}
  description={`Online & Virtual metabolic care for ${diseaseLabel} serving ${cityLabel}, ${regionLabel}. Telehealth circadian nutrition programs supervised by Dr. Shilpa Thakur via Video, WhatsApp, and Email.`}
  ogImage={`/og/clinic/${city}-${disease}.png`}
  geoRegion={regionLabel}
  geoPlacename={cityLabel}
  disease={disease}
  schemas={[clinicSchema, faqSchema].filter(Boolean)}
>
  
  {/* Semantic AIO Context for RAG Parsers & AI Overviews */}
  {loc && matchedTopic && (
    <aside class="aio-summary bg-emerald-50/50 border border-emerald-100 p-6 rounded-2xl mb-8 shadow-sm" role="note" data-nosnippet="false">
      <h2 class="text-sm font-black text-emerald-900 uppercase tracking-widest mb-2 flex items-center gap-2">
        <Icons name="sparkles" size={16} /> Clinical AI Summary
      </h2>
      <div class="text-sm text-emerald-800/90 leading-relaxed font-medium">
        NutritionColours provides 100% online, virtual, and on-call targeted clinical interventions for {diseaseLabel} serving patients in {cityLabel}. 
        Consultations are fully remote via Video, WhatsApp, and Email.
        Key Regional Deficiency Risk: {loc.regionalDeficiencyRisk}. 
        Therapeutic Spice Synergy: {loc.localTherapeuticSpice}.
        Target Biomarker: {loc.clinicalTargetBiomarker}.
        Demographic Footprint: Serving a local population of {loc.population}.
      </div>
    </aside>
  )}

  {loc && matchedTopic && (
    <div class="max-w-5xl mx-auto px-6 pt-2 pb-4">
      <div class="rounded-3xl border border-stone-100 bg-stone-50/50 p-8 space-y-4 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <span class="px-4 py-1.5 bg-emerald-50 text-emerald-800 text-[10px] font-black uppercase tracking-widest rounded-full inline-flex items-center gap-1.5 shadow-sm border border-emerald-100">
            💻 100% Online / Virtual Care Program
          </span>
          {loc.population && (
            <span class="text-[10px] font-semibold text-stone-500 uppercase tracking-widest">
              Serving a population of {formatPop(loc.population)} in {regionLabel}
            </span>
          )}
        </div>
        
        <h1 class="text-3xl md:text-5xl font-black text-emerald-950 brand-font leading-tight">
          Online {diseaseLabel} Specialist Serving {cityLabel}, {regionLabel}
        </h1>
        
        <div class="text-stone-700 text-sm leading-relaxed max-w-3xl space-y-4">
          <p>
            NutritionColours offers personalized remote clinical nutrition programs designed to support individuals managing <strong><a href={`/topic/${disease}`} class="text-emerald-800 underline hover:text-emerald-600 font-semibold">{diseaseLabel}</a></strong> from the comfort of your home in <strong>{cityLabel}</strong> and the surrounding {regionLabel} region. Our metabolic support programs are delivered entirely <strong>online, on call, via WhatsApp, Video, and emails</strong>. We address dietary and lifestyle factors associated with chronic conditions, specifically focusing on: <em>{matchedTopic.problem}</em>. By aligning food timing and nutrient density with our evidence-qualified virtual protocol: <em>{matchedTopic.solution}</em>, we help manage cellular response and metabolic markers under continuous clinical guidance.
          </p>

          <div class="my-6 grid md:grid-cols-2 gap-4">
             {/* Microclimate Box */}
             <div class="bg-white p-5 rounded-2xl border border-emerald-100 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-emerald-400"></div>
                <h3 class="text-[10px] uppercase font-black tracking-widest text-emerald-800 mb-2 flex items-center gap-2">
                  🌦️ Microclimate & Metabolic Impact
                </h3>
                <p class="text-xs text-stone-600 font-medium mb-1"><strong>Local Weather:</strong> {loc.weather}</p>
                <p class="text-xs text-stone-600">{loc.microclimateMetabolicImpact || 'Regional climate influences basal metabolic rate, requiring localized hydration and thermal-nutritional adjustments.'}</p>
             </div>

             {/* Circadian Box */}
             <div class="bg-white p-5 rounded-2xl border border-orange-100 shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-1 h-full bg-orange-400"></div>
                <h3 class="text-[10px] uppercase font-black tracking-widest text-orange-800 mb-2 flex items-center gap-2">
                  ⏱️ Regional Circadian Challenge
                </h3>
                <p class="text-xs text-stone-600">{loc.circadianChallenge || 'Urban lifestyle pacing and indoor lighting heavily disrupt the central clock, necessitating structured chrononutrition protocols.'}</p>
             </div>
          </div>

          <p>
            Our specialized programs prioritize chronobiology—the science of your body's biological clock. For clients in the {cityLabel} area, we incorporate regional dietary habits and local produce availability to design a sustainable nutrition protocol. This involves coordinating meal times with natural daylight cycles, optimizing macronutrient distribution, and utilizing nutrient-dense foods to support healthy hormone and glycemic responses.
          </p>

          {/* Hyper-Local Dietary Matrix */}
          {(loc.commonStaples || loc.regionalStapleAlternative) && (
            <div class="bg-stone-100/50 p-5 rounded-xl border border-stone-200 my-6">
              <h3 class="text-xs uppercase font-black tracking-widest text-stone-800 mb-3 text-center">Dietary Optimization Matrix for {cityLabel}</h3>
              <div class="flex flex-col md:flex-row gap-4">
                 <div class="flex-1 bg-white p-4 rounded-lg border border-red-100">
                    <span class="text-[10px] uppercase font-bold text-red-600 block mb-1">❌ Common Regional Staples (Limit)</span>
                    <span class="text-xs text-stone-700">{loc.commonStaples || 'Processed carbohydrates and industrial seed oils'}</span>
                 </div>
                 <div class="flex-1 bg-white p-4 rounded-lg border border-emerald-100">
                    <span class="text-[10px] uppercase font-bold text-emerald-700 block mb-1">✅ Clinical Alternatives (Prioritize)</span>
                    <span class="text-xs text-stone-700">{loc.regionalStapleAlternative || 'High-fiber ancestral grains, organic lean proteins, and cold-pressed traditional lipids'}</span>
                 </div>
              </div>
            </div>
          )}

          <p>
            <strong>Local Lab Testing & Remote Biomarker Tracking:</strong> To ensure clinical precision, clients are encouraged to obtain regular blood biomarker panels from certified diagnostic labs in {cityLabel}. Key markers such as fasting insulin, HbA1c, and lipid panels are utilized to track metabolic progress. You simply share these reports with us online, and our team reviews your external lab results to dynamically adjust your circadian swap schedule and nutrient targets via our virtual care channels.
          </p>
          <p>
            <strong>Root-Cause Metabolic Pathophysiology:</strong> Addressing {diseaseLabel} requires a systematic shift from simple symptom management to resolving underlying cellular stressors. In many patients, chronic nutrient imbalances, sleep disruptions, and elevated toxic loads can impair insulin receptor sensitivity, stress the liver, and increase cardiovascular load. Our protocols emphasize targeted dietary swaps (such as whole, visual-pigment plant foods from our Nutritional Color Code system) that provide the specific micronutrients needed for tissue recovery and metabolic pathway clearance.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
          <div class="bg-white p-4 rounded-2xl border border-stone-100 shadow-sm flex flex-col justify-center">
            <span class="text-[9px] uppercase font-black tracking-widest text-stone-500 block mb-1">Target Biomarker</span>
            <span class="text-xs font-bold text-stone-800">{loc.clinicalTargetBiomarker || 'Insulin & Inflammatory Markers'}</span>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-stone-100 shadow-sm flex flex-col justify-center">
            <span class="text-[9px] uppercase font-black tracking-widest text-stone-500 block mb-1">Therapeutic Spice Synergy</span>
            {spiceUrl ? (
              <a href={spiceUrl} class="text-xs font-bold text-emerald-700 hover:underline">{loc.localTherapeuticSpice}</a>
            ) : (
              <span class="text-xs font-bold text-stone-800">{loc.localTherapeuticSpice || 'Seasonal Local Spices'}</span>
            )}
          </div>
          <div class="bg-white p-4 rounded-2xl border border-stone-100 shadow-sm flex flex-col justify-center">
            <span class="text-[9px] uppercase font-black tracking-widest text-stone-500 block mb-1">Prevalent Local Produce</span>
            <span class="text-xs font-bold text-stone-800 line-clamp-2">{loc.localProduceSynergy || 'Vegetables & specific botanicals'}</span>
          </div>
          <div class="bg-white p-4 rounded-2xl border border-stone-100 shadow-sm flex flex-col justify-center">
            <span class="text-[9px] uppercase font-black tracking-widest text-stone-500 block mb-1">Regional Deficiency Risk</span>
            {deficiencyUrl ? (
              <a href={deficiencyUrl} class="text-xs font-bold text-orange-600 hover:underline">{loc.regionalDeficiencyRisk}</a>
            ) : (
              <span class="text-xs font-bold text-orange-600">{loc.regionalDeficiencyRisk || 'Vitamin D3 & B12'}</span>
            )}
          </div>
        </div>

        {((loc.localFruits?.length || 0) + (loc.localVegetables?.length || 0)) > 0 && (
          <div class="flex flex-wrap items-center gap-2 bg-white p-6 rounded-2xl border border-stone-100 shadow-sm mt-4">
            <span class="text-[10px] uppercase font-black tracking-widest text-emerald-700 mr-1 w-full mb-2 border-b border-stone-100 pb-2">Local Fruits & Vegetables Used In Protocols</span>
            {[...(loc.localFruits || []), ...(loc.localVegetables || [])].map((item: string) => {
              const url = findEntityUrl(item);
              return url ? (
                <a href={url} class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-100 px-3 py-1 rounded-full hover:bg-emerald-200 transition-colors">{item}</a>
              ) : (
                <span class="text-xs font-bold text-stone-500 bg-stone-100 px-3 py-1 rounded-full">{item}</span>
              );
            })}
          </div>
        )}

        {localRecipes.length > 0 && (
          <div class="flex flex-wrap items-center gap-2 bg-white p-6 rounded-2xl border border-stone-100 shadow-sm mt-4">
            <span class="text-[10px] uppercase font-black tracking-widest text-emerald-700 mr-1 w-full mb-2 border-b border-stone-100 pb-2">Local Recipes &amp; Therapeutic Dishes</span>
            {localRecipes.map((r) => (
              <a href={r.url} class="text-xs font-bold text-lime-800 bg-lime-50 border border-lime-200 px-3 py-1 rounded-full hover:bg-lime-200 transition-colors">{r.title}</a>
            ))}
          </div>
        )}
        
        {loc.healthIssues && loc.healthIssues.length > 0 && (
          <div class="mt-8 pt-6 border-t border-stone-200">
            <h3 class="text-[10px] uppercase tracking-widest font-black text-stone-500 mb-3">
              Other Metabolic Programs in {cityLabel}
            </h3>
            <div class="flex flex-wrap gap-2">
              {loc.healthIssues.filter((hi: string) => hi !== diseaseLabel).map((hi: string) => {
                // Find matching topic ID from TOPICS if possible, otherwise slugify
                const linkedTopic = TOPICS.find(t => t.title.toLowerCase() === hi.toLowerCase() || t.shortDesc.toLowerCase().includes(hi.toLowerCase()));
                const targetSlug = linkedTopic ? linkedTopic.id : hi.toLowerCase().replace(/[^a-z0-9]/g, '-');
                return (
                  <a href={`/clinic/${city}/${targetSlug}`} class="px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-700 rounded-lg text-[10px] font-semibold transition-all">
                    {hi}
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {/* Tiered Semantic Cluster & External Trust Citations */}
        <RelatedLeaves disease={disease} formula={Astro.locals.hubFormula} />

        <div class="mt-6 flex flex-wrap gap-4 items-center border-t border-stone-200 pt-6">
          <a href={`https://wa.me/917696160133?text=${encodeURIComponent(`Hi, I'm from ${cityLabel} and I'd like to know more about the ${diseaseLabel} metabolic program.`)}`}
             target="_blank"
             rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-600 text-white text-sm font-bold hover:bg-emerald-700 transition-colors shadow-md">
            <Icons name="whatsapp" size={18} /> Chat on WhatsApp
          </a>
          <span class="text-xs font-semibold text-stone-500">Remote Consultations Available Worldwide</span>
        </div>
        
        {nearestHubs && nearestHubs.length > 0 && (
          <div class="mt-6 pt-6 border-t border-stone-200">
            <h3 class="text-xs uppercase tracking-widest font-black text-emerald-800 mb-3">
              Broader Regional Telehealth Coverage
            </h3>
            <p class="text-[10px] text-stone-500 mb-3">
              {loc.population && loc.population < 100000 
                ? `While direct localized diagnostic centers may be sparse in ${cityLabel}, our remote monitoring ensures you receive the same elite care as patients in our larger regional hubs.` 
                : `Our remote metabolic network spans across the region. Patients in ${cityLabel} often coordinate their localized diagnostics with our broader telehealth coverage.`}
            </p>
            <div class="flex flex-wrap gap-2">
              {nearestHubs.map((hub: any) => (
                <a href={`/clinic/${hub.slug}/${disease}`}
                   class="px-3 py-1.5 bg-white hover:bg-emerald-50 text-stone-700 hover:text-emerald-950 rounded-lg text-[10px] font-semibold border border-stone-200 hover:border-emerald-200 transition-all shadow-sm">
                  Remote Care for {hub.city} ({Math.round(hub.distance)} km)
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  )}

  <ClinicClientPage
    client:only="react"
    currentPath={`clinic/${city || ''}`}
    activeClinicProp={loc}
    navigate={(path) => { if (typeof globalThis !== 'undefined' && globalThis.window) globalThis.window.location.href = '/' + path; }}
  />
</BaseLayout>
</div>
