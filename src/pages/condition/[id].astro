---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ClinicalConditionDetail } from '../../components/ClinicalDetails';
import { MEDICAL_CONDITIONS_DATA, HERBS_SPICES_DATA } from '../../lib/clinical_databases';

export async function getStaticPaths() {
  return MEDICAL_CONDITIONS_DATA.map((cond) => ({
    params: { id: cond.id },
    props: { cond },
  }));
}

const { cond } = Astro.props;

// Construct rich keywords
const allKeywords = [
  cond.name,
  `${cond.name} reversal`,
  `${cond.name} diet plan`,
  `${cond.name} protocol`,
  "metabolic nutrition",
  "circadian health",
  ...(cond.seoKeywords || [])
];

// Context Schema
const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
const conditionSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "url": `${SITE_URL}/condition/${cond.id}`,
  "name": `${cond.name} Reversal Protocol | Clinical Nutrition`,
  "description": cond.rootCause,
  "lastReviewed": cond.clinicalReview?.lastUpdated || new Date().toISOString().split('T')[0],
  "reviewedBy": {
    "@type": "Physician",
    "name": "Dr. Shilpa Thakur",
    "identifier": "NUTR-SHILPA-001"
  }
};
---
<div data-ai-answer="true">

<BaseLayout
  title={`${cond.name} - Reversal Protocol | NutritionColours`}
  description={cond.rootCause}
  keywords={allKeywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(conditionSchema)} />
  
  <ClinicalConditionDetail client:load cond={cond} herbsData={HERBS_SPICES_DATA} />

  {/* Rich Server-Rendered Clinical Guideline (SEO / AEO / GEO / AIO / View-Source Law) */}
  <div class="max-w-7xl mx-auto px-6 pb-24 -mt-12">
    <section class="prose prose-emerald max-w-none text-stone-700 bg-white p-8 md:p-12 rounded-[40px] border border-stone-150/40 shadow-sm space-y-8">
      
      <div>
        <span class="text-lime-600 font-black uppercase tracking-[0.2em] text-[10px] block mb-2">Scientific Monograph & Reference</span>
        <h2 class="text-3xl font-black text-emerald-950 brand-font leading-tight m-0">
          Pathophysiology & Reversal Architecture for {cond.name}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-8 pt-4">
        <div class="space-y-4">
          <h3 class="text-lg font-extrabold text-emerald-900 m-0">Root-Cause Pathology</h3>
          <p class="text-sm leading-relaxed" data-ai-answer="true">
            Addressing <strong>{cond.name}</strong> requires targeting the root-cause cellular and metabolic dysfunctions. Rather than simply managing secondary clinical symptoms, our precision nutrition framework focuses on restoring systemic homeostasis, reducing insulin resistance, and optimizing mitochondrial function. Chronic cell-level stress, combined with poor dietary habits and environmental factors, can impair the body's natural clearance pathways and lead to tissue-level degeneration. By systematically removing environmental triggers and aligning diet with cellular requirements, we support the body's native recovery processes.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-lg font-extrabold text-emerald-900 m-0">Circadian & Chrononutritional Guidelines</h3>
          <p class="text-sm leading-relaxed" data-ai-answer="true">
            Chrononutrition plays a central role in resolving {cond.name}. Nutrient metabolism is closely tied to natural circadian rhythms and clock gene expression. We recommend structuring meal times within a consistent daily eating window aligned with daylight hours. This approach optimizes liver glycogen storage, coordinates digestive enzyme activity, and supports overnight cellular repair. Avoiding late-evening meals reduces metabolic load, prevents overnight glucose spikes, and helps maintain insulin sensitivity.
          </p>
        </div>
      </div>

      <hr class="border-stone-100 my-8" />

      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-6 bg-stone-50 rounded-3xl space-y-3">
          <h4 class="text-xs font-black uppercase tracking-wider text-emerald-800 m-0">Therapeutic Swaps</h4>
          <p class="text-xs leading-relaxed text-stone-600">
            Integrate therapeutic spices—such as {cond.therapeuticSpices.join(', ')}—into your daily meals. These botanicals contain active compounds (polyphenols, alkaloids, and flavonoids) that help downregulate inflammatory pathways and improve cellular receptor sensitivity.
          </p>
        </div>

        <div class="p-6 bg-red-50/50 border border-red-100/30 rounded-3xl space-y-3">
          <h4 class="text-xs font-black uppercase tracking-wider text-red-800 m-0">Prohibited Inputs</h4>
          <p class="text-xs leading-relaxed text-stone-600">
            Strictly avoid trigger foods, including {cond.prohibitedFoods.join(', ')}. These inputs can stress metabolic clearance pathways, trigger systemic inflammatory responses, and compromise gut barrier integrity, delaying recovery.
          </p>
        </div>

        <div class="p-6 bg-stone-50 rounded-3xl space-y-3">
          <h4 class="text-xs font-black uppercase tracking-wider text-emerald-800 m-0">Biomarker Targets</h4>
          <p class="text-xs leading-relaxed text-stone-600">
            Work with your healthcare team to monitor key laboratory biomarkers, including {cond.biomarkers.join(', ')}. Regular tracking allows for data-driven adjustments to your protocol based on your unique metabolic response.
          </p>
        </div>
      </div>

      <div class="pt-6 space-y-4">
        <h3 class="text-xl font-bold text-emerald-900 m-0">Precision Integration & Clinical Oversight</h3>
        <p class="text-sm leading-relaxed">
          These guidelines are designed to complement standard medical treatments under the supervision of a registered dietitian or clinical specialist. Regular monitoring of diagnostic markers, combined with consistent compliance with evidence-graded nutrition plans, provides a safe, personalized path toward metabolic optimization and systemic wellness. Consuming a diverse spectrum of organic plant pigments—following our <strong>Nutritional Color Code system (NutritionColours)</strong>—provides the essential phytonutrients required to support cellular health and promote long-term vitality.
        </p>
      </div>

      {cond.faqs && cond.faqs.length > 0 && (
        <div class="pt-8 border-t border-stone-100 space-y-6">
          <h3 class="text-xl font-black text-emerald-950 m-0">Clinical Questions & Answers</h3>
          <div class="space-y-6">
            {cond.faqs.map((faq: any) => (
              <div class="space-y-2">
                <h4 class="text-sm font-extrabold text-stone-900 flex items-start gap-2 m-0">
                  <span class="text-emerald-700">Q:</span> {faq.question}
                </h4>
                <p class="text-xs leading-relaxed text-stone-600 pl-5 m-0">
                  {faq.answer}
                </p>
              </div>
            ))}
          </div>
        </div>
      )}

    </section>
  </div>
</BaseLayout>
</div>
