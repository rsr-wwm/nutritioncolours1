---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icons from '../components/Icons.astro';
---
<BaseLayout
  title="About | NutritionColours"
  description="Learn about NutritionColours, its educational scope, publishing safeguards, evidence boundaries, and limits on health advice and services."
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about' },
  ]}
>
  <article class="max-w-5xl mx-auto px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">About</li>
      </ol>
    </nav>

    <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800 dark:text-emerald-300">
      <span class="inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
      Independent Educational Platform
    </div>

    <h1 class="mt-4 text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">
      Clearer food and nutrition education
    </h1>

    <p class="mt-6 text-lg leading-relaxed text-stone-700 dark:text-stone-300 border-l-4 border-emerald-500 pl-5">
      NutritionColours is an independent nutrition education platform. We provide evidence-anchored food composition directories, circadian chrono-nutrition guides, and rigorous review-status notices while legacy health drafts remain withdrawn. We do not operate a physical clinic, diagnostic intake service, or emergency triage facility.
    </p>

    <!-- Comparative Matrix: What Belongs Here vs What Does Not -->
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <!-- Left Card: What Belongs Here -->
      <section class="card-interactive rounded-3xl border border-emerald-200 dark:border-emerald-800/80 bg-emerald-50/50 dark:bg-emerald-950/30 p-7 md:p-8 shadow-sm space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800" aria-hidden="true">
            <Icons name="check" size={16} />
          </span>
          <h2 class="text-xl font-black text-emerald-950 dark:text-emerald-100 brand-font">What belongs here</h2>
        </div>
        <ul class="space-y-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700 dark:text-emerald-400">&bull;</span>
            <span>Primary human clinical literature and systematic reviews indexed with active DOIs.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700 dark:text-emerald-400">&bull;</span>
            <span>Official biochemical food composition tables (USDA FoodData Central, ICMR-IFCT).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700 dark:text-emerald-400">&bull;</span>
            <span>Clear physiological uncertainties, contraindications, and emergency boundaries.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-emerald-700 dark:text-emerald-400">&bull;</span>
            <span>Prompt, public corrections when newer peer-reviewed literature supercedes older trials.</span>
          </li>
        </ul>
      </section>

      <!-- Right Card: What Does Not Belong Here -->
      <section class="card-interactive rounded-3xl border border-rose-200 dark:border-rose-900/60 bg-rose-50/50 dark:bg-rose-950/20 p-7 md:p-8 shadow-sm space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-rose-100 dark:bg-rose-900/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-900" aria-hidden="true">
            <Icons name="x" size={16} />
          </span>
          <h2 class="text-xl font-black text-rose-950 dark:text-rose-100 brand-font">What does not</h2>
        </div>
        <ul class="space-y-3 text-sm leading-relaxed text-stone-700 dark:text-stone-300">
          <li class="flex items-start gap-2">
            <span class="font-bold text-rose-600 dark:text-rose-400">&bull;</span>
            <span>Guaranteed biological outcomes, miracle diets, or disease reversal promises.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-rose-600 dark:text-rose-400">&bull;</span>
            <span>Fabricated patient testimonials, commercial sponsorships, or undisclosed endorsements.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-rose-600 dark:text-rose-400">&bull;</span>
            <span>Simulated walk-in clinics, fake physical locality pages, or local doorway spam.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="font-bold text-rose-600 dark:text-rose-400">&bull;</span>
            <span>Machine-generated AI assertions that exceed verifiable primary trial records.</span>
          </li>
        </ul>
      </section>
    </div>

    <!-- Editorial Governance & Corrections Block -->
    <section class="mt-10 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-7 md:p-8 shadow-sm space-y-3">
      <h2 class="text-2xl font-black text-emerald-950 dark:text-emerald-100 brand-font">Editorial governance & corrections</h2>
      <p class="text-base leading-relaxed text-stone-700 dark:text-stone-300">
        If you spot an inaccurate claim, outdated citation, or text lacking adequate scientific sourcing, please email <a class="font-bold text-emerald-800 dark:text-emerald-400 underline underline-offset-4" href="mailto:info@nutritioncolours.com">info@nutritioncolours.com</a> with the URL and supporting peer-reviewed reference. Unreviewed drafts remain strictly quarantined from search indexing.
      </p>
    </section>

    <!-- Action Shortcuts -->
    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold">
      <a href="/legal/editorial-policy" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-5 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors">
        Read editorial policy
      </a>
      <a href="/knowledge" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-5 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Knowledge directory
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-5 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Contact desk
      </a>
    </div>
  </article>
</BaseLayout>
