---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icons from '../../components/Icons.astro';
import { PILLARS, getTaxonomyDetails } from '../../lib/seo/taxonomyEngine';
import { getRecipesForFood, getLocationsForFood } from '../../lib/seo/autoLinker';
import { getSiteUrl } from '../../utils/siteUrl';

const origin = 'https://www.nutrition-protocols.com';

// Pillars that are all "food" in the everyday sense — cross-linked to each other so, e.g.,
// Fruits is reachable from the Foods hub and vice versa, even though each is its own top-level pillar.
const FOOD_FAMILY_PILLARS = [
  'foods', 'fruits', 'vegetables', 'herbs', 'seeds', 'spices', 'grains', 'pulses-legumes',
  'dairy-alternatives', 'healthy-drinks-beverages', 'functional-foods', 'fermented-foods',
  'oils-healthy-fats', 'nutrient-database', 'vitamins', 'minerals', 'phytonutrients', 'bioactive-compounds',
];

export async function getStaticPaths() {
  const knowledgeEntries = await getCollection('knowledge');
  const paths: any[] = [];

  // Mappings to track parents and children
  const mainCategoriesMap = new Map<string, { slug: string; name: string; categories: Set<string> }>();
  const categoriesMap = new Map<string, { slug: string; name: string; techName?: string; mainCategory: { slug: string; name: string }; subCategories: Set<string> }>();
  const subCategoriesMap = new Map<string, { slug: string; name: string; commonName?: string; category: { slug: string; name: string }; mainCategory: { slug: string; name: string }; articles: any[] }>();

  // 1. Process all Articles and group them
  knowledgeEntries.forEach((entry) => {
    const tax = getTaxonomyDetails(entry);
    if (!tax) return;

    // Push the article route
    paths.push({
      params: { slug: `${tax.mainCategory.slug}/${tax.category.slug}/${tax.subCategory.slug}/${tax.articleSlug}` },
      props: { type: 'article', entry, tax }
    });

    // Populate Main Category map
    if (!mainCategoriesMap.has(tax.mainCategory.slug)) {
      mainCategoriesMap.set(tax.mainCategory.slug, {
        slug: tax.mainCategory.slug,
        name: tax.mainCategory.name,
        categories: new Set()
      });
    }
    mainCategoriesMap.get(tax.mainCategory.slug)!.categories.add(tax.category.slug);

    // Populate Category map
    const catKey = `${tax.mainCategory.slug}/${tax.category.slug}`;
    if (!categoriesMap.has(catKey)) {
      categoriesMap.set(catKey, {
        slug: tax.category.slug,
        name: tax.category.name,
        techName: tax.category.techName,
        mainCategory: tax.mainCategory,
        subCategories: new Set()
      });
    }
    categoriesMap.get(catKey)!.subCategories.add(tax.subCategory.slug);

    // Populate Sub-Category map
    const subCatKey = `${tax.mainCategory.slug}/${tax.category.slug}/${tax.subCategory.slug}`;
    if (!subCategoriesMap.has(subCatKey)) {
      subCategoriesMap.set(subCatKey, {
        slug: tax.subCategory.slug,
        name: tax.subCategory.name,
        commonName: tax.subCategory.commonName,
        category: tax.category,
        mainCategory: tax.mainCategory,
        articles: []
      });
    }
    subCategoriesMap.get(subCatKey)!.articles.push({ entry, tax });
  });

  // 2. Generate Main Category routes (Level 1)
  mainCategoriesMap.forEach((mc) => {
    const categoriesList = Array.from(mc.categories).map((cSlug) => {
      const catKey = `${mc.slug}/${cSlug}`;
      const catDetails = categoriesMap.get(catKey);
      
      // Calculate counts
      let subCatsCount = 0;
      let articlesCount = 0;
      if (catDetails) {
        subCatsCount = catDetails.subCategories.size;
        catDetails.subCategories.forEach((scSlug) => {
          const scKey = `${mc.slug}/${cSlug}/${scSlug}`;
          articlesCount += subCategoriesMap.get(scKey)?.articles.length || 0;
        });
      }

      return {
        slug: cSlug,
        name: catDetails?.name || cSlug,
        techName: catDetails?.techName,
        subCatsCount,
        articlesCount
      };
    });

    if (mc.slug !== 'herbs' && mc.slug !== 'spices') {
      paths.push({
        params: { slug: mc.slug },
        props: {
          type: 'mainCategory',
          mainCategory: {
            slug: mc.slug,
            name: mc.name,
            info: PILLARS[mc.slug],
            categories: categoriesList
          }
        }
      });
    }
  });

  // 3. Generate Category routes (Level 2)
  categoriesMap.forEach((cat, key) => {
    const subCategoriesList = Array.from(cat.subCategories).map((scSlug) => {
      const scKey = `${cat.mainCategory.slug}/${cat.slug}/${scSlug}`;
      const scDetails = subCategoriesMap.get(scKey);
      return {
        slug: scSlug,
        name: scDetails?.name || scSlug,
        commonName: scDetails?.commonName,
        articlesCount: scDetails?.articles.length || 0,
        articles: scDetails?.articles.map(a => ({
          title: a.entry.data.title,
          slug: a.tax.articleSlug,
          canonicalUrl: a.tax.canonicalUrl
        })) || []
      };
    });

    paths.push({
      params: { slug: key },
      props: {
        type: 'category',
        category: {
          slug: cat.slug,
          name: cat.name,
          techName: cat.techName,
          mainCategory: cat.mainCategory,
          subCategories: subCategoriesList
        }
      }
    });
  });

  // 4. Generate Sub-Category routes (Level 3)
  subCategoriesMap.forEach((sub, key) => {
    paths.push({
      params: { slug: key },
      props: {
        type: 'subCategory',
        subCategory: {
          slug: sub.slug,
          name: sub.name,
          commonName: sub.commonName,
          category: sub.category,
          mainCategory: sub.mainCategory,
          articles: sub.articles.map(a => ({
            title: a.entry.data.title,
            description: a.entry.data.description,
            slug: a.tax.articleSlug,
            canonicalUrl: a.tax.canonicalUrl
          }))
        }
      }
    });
  });

  return paths;
}

const props = Astro.props;
const { type } = props;

// Schema generation logic helper
let jsonLd = '';
let pageTitle = '';
let pageDescription = '';
let pageKeywords: string[] = [];

if (type === 'article') {
  const { entry, tax } = props;
  const { Content } = await render(entry);
  props.Content = Content; // attach for rendering below

  pageTitle = `${entry.data.title} | ${tax.category.name} Protocol`;
  pageDescription = entry.data.description;
  pageKeywords = entry.data.seoKeywords || [];

  if (entry.data.category === 'Health Conditions' || entry.data.category === 'Diseases' || tax.mainCategory.slug === 'diseases') {
    jsonLd = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      'url': `${origin}${Astro.url.pathname}`,
      'name': entry.data.title,
      'description': entry.data.description,
      'lastReviewed': entry.data.lastUpdated || new Date().toISOString().split('T')[0],
      'reviewedBy': {
        '@type': 'Physician',
        'name': 'Dr. Shilpa Thakur',
        'identifier': 'NUTR-SHILPA-001'
      }
    });
  } else {
    jsonLd = JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'MedicalWebPage',
      'url': getSiteUrl(Astro.url.href),
      'name': entry.data.title,
      'description': entry.data.description
    });
  }

  // Get related articles in the same subcategory
  const knowledgeEntries = await getCollection('knowledge');
  props.relatedArticles = knowledgeEntries
    .map(e => ({ entry: e, tax: getTaxonomyDetails(e) }))
    .filter(item => item.tax && item.tax.mainCategory.slug === tax.mainCategory.slug && item.tax.category.slug === tax.category.slug && item.tax.subCategory.slug === tax.subCategory.slug && item.tax.articleSlug !== tax.articleSlug)
    .map(item => ({
      title: item.entry.data.title,
      canonicalUrl: item.tax!.canonicalUrl
    }));

  // "Wise-versa" interlinking (food pillars only): the plain food name behind a title like
  // "Mango (Mangifera indica) — Nutrition, Composition & Health" is "Mango" — strip the
  // em-dash suffix and any scientific-name parenthetical before matching recipes/locations.
  const cleanFoodName = entry.data.title.split(' — ')[0].replace(/\s*\([^)]*\)\s*$/, '').trim();
  props.recipesForFood = FOOD_FAMILY_PILLARS.includes(tax.mainCategory.slug) ? getRecipesForFood(cleanFoodName) : [];
  props.locationsForFood = FOOD_FAMILY_PILLARS.includes(tax.mainCategory.slug) ? getLocationsForFood(cleanFoodName) : [];
} else if (type === 'mainCategory') {
  const { mainCategory } = props;
  pageTitle = `${mainCategory.name} - Clinical Hub | NutritionColours`;
  pageDescription = mainCategory.info?.description || `Explore detailed protocols and guidelines for ${mainCategory.name}.`;
  pageKeywords = [mainCategory.name, "clinical protocols", "nutrition research"];

  const origin = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
  const itemListElements = (mainCategory.categories || []).map((cat: any, i: number) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': cat.name,
    'url': `${origin}/knowledge/${mainCategory.slug}/${cat.slug}`
  }));
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['CollectionPage', 'MedicalWebPage'],
        'url': `${origin}${Astro.url.pathname}`,
        'name': mainCategory.name,
        'description': pageDescription,
        'mainEntity': { '@type': 'ItemList', 'numberOfItems': itemListElements.length, 'itemListElement': itemListElements }
      },
      {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${origin}/` },
          { '@type': 'ListItem', 'position': 2, 'name': 'Knowledge', 'item': `${origin}/knowledge` },
          { '@type': 'ListItem', 'position': 3, 'name': mainCategory.name, 'item': `${origin}${Astro.url.pathname}` }
        ]
      }
    ]
  });
} else if (type === 'category') {
  const { category } = props;
  pageTitle = `${category.name} (${category.techName || ''}) | Clinical Category`;
  pageDescription = `Browse evidence-graded clinical subcategories and protocols for ${category.name}.`;
  pageKeywords = [category.name, category.techName || '', "protocols"];

  const origin = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
  const itemListElements = (category.subCategories || []).map((sub: any, i: number) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': sub.name,
    'url': `${origin}/knowledge/${category.mainCategory.slug}/${category.slug}/${sub.slug}`
  }));
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['CollectionPage', 'MedicalWebPage'],
        'url': `${origin}${Astro.url.pathname}`,
        'name': category.name,
        'description': pageDescription,
        'mainEntity': { '@type': 'ItemList', 'numberOfItems': itemListElements.length, 'itemListElement': itemListElements }
      },
      {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${origin}/` },
          { '@type': 'ListItem', 'position': 2, 'name': 'Knowledge', 'item': `${origin}/knowledge` },
          { '@type': 'ListItem', 'position': 3, 'name': category.mainCategory.name, 'item': `${origin}/knowledge/${category.mainCategory.slug}` },
          { '@type': 'ListItem', 'position': 4, 'name': category.name, 'item': `${origin}${Astro.url.pathname}` }
        ]
      }
    ]
  });
} else if (type === 'subCategory') {
  const { subCategory } = props;
  pageTitle = `${subCategory.name} - Protocols | Clinical Index`;
  pageDescription = `Browse all clinical articles, research-backed guidelines, and wellness swaps for ${subCategory.name}.`;
  pageKeywords = [subCategory.name, subCategory.commonName || '', "guidelines"];

  const origin = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
  const itemListElements = (subCategory.articles || []).map((art: any, i: number) => ({
    '@type': 'ListItem',
    'position': i + 1,
    'name': art.title,
    'url': art.canonicalUrl.startsWith('http') ? art.canonicalUrl : `${origin}${art.canonicalUrl}`
  }));
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': ['CollectionPage', 'MedicalWebPage'],
        'url': `${origin}${Astro.url.pathname}`,
        'name': subCategory.name,
        'description': pageDescription,
        'mainEntity': { '@type': 'ItemList', 'numberOfItems': itemListElements.length, 'itemListElement': itemListElements }
      },
      {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': `${origin}/` },
          { '@type': 'ListItem', 'position': 2, 'name': 'Knowledge', 'item': `${origin}/knowledge` },
          { '@type': 'ListItem', 'position': 3, 'name': subCategory.mainCategory.name, 'item': `${origin}/knowledge/${subCategory.mainCategory.slug}` },
          { '@type': 'ListItem', 'position': 4, 'name': subCategory.category.name, 'item': `${origin}/knowledge/${subCategory.mainCategory.slug}/${subCategory.category.slug}` },
          { '@type': 'ListItem', 'position': 5, 'name': subCategory.name, 'item': `${origin}${Astro.url.pathname}` }
        ]
      }
    ]
  });
}
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />

  {/* LEVEL 1: MAIN CATEGORY HUB */}
  {type === 'mainCategory' && (
    <main class="space-y-16 pb-24 bg-stone-50/50">
      <div class="bg-emerald-950 text-white pt-24 pb-16 px-6 relative overflow-hidden">
        <div class="max-w-7xl mx-auto space-y-4 relative z-10">
          <nav class="flex text-xs font-semibold text-emerald-300 mb-6 uppercase tracking-wider" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-2">
              <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
              <li><span class="mx-2 text-emerald-500">/</span></li>
              <li><a href="/knowledge" class="hover:text-white transition-colors">Knowledge</a></li>
              <li><span class="mx-2 text-emerald-500">/</span></li>
              <li><span class="text-white">{props.mainCategory.name}</span></li>
            </ol>
          </nav>
          
          <h1 class="text-4xl md:text-6xl font-black brand-font tracking-tight leading-[0.9]">
            {props.mainCategory.name}
          </h1>
          <p class="max-w-3xl text-emerald-100/80 leading-relaxed font-medium">
            {props.mainCategory.info?.description}
          </p>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {props.mainCategory.categories.map((cat: any) => (
            <a
              href={`/knowledge/${props.mainCategory.slug}/${cat.slug}`}
              class="bg-white border border-stone-150/40 p-8 rounded-3xl hover:border-emerald-300 hover:shadow-xl transition-all duration-300 group flex flex-col justify-between h-64"
            >
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="text-[9px] font-black uppercase tracking-widest text-lime-600 bg-lime-50 px-2 py-0.5 rounded">
                    Category
                  </span>
                  {cat.techName && (
                    <span class="text-[9px] font-mono text-stone-400">
                      {cat.techName}
                    </span>
                  )}
                </div>
                <h2 class="text-xl font-black text-emerald-950 brand-font group-hover:text-emerald-800 transition-colors">
                  {cat.name}
                </h2>
              </div>

              <div class="flex items-center justify-between text-xs font-bold text-stone-400 uppercase tracking-widest pt-4 border-t border-stone-100">
                <span>{cat.subCatsCount} Sub-Categories</span>
                <span class="w-1.5 h-1.5 rounded-full bg-stone-300"></span>
                <span>{cat.articlesCount} Articles</span>
              </div>
            </a>
          ))}
        </div>

        {FOOD_FAMILY_PILLARS.includes(props.mainCategory.slug) && (
          <section class="mt-16">
            <h2 class="text-xs font-black uppercase tracking-[0.3em] text-emerald-700 border-l-4 border-lime-400 pl-4 mb-6">
              Browse Other Food Categories
            </h2>
            <div class="flex flex-wrap gap-3">
              {FOOD_FAMILY_PILLARS.filter((slug: string) => slug !== props.mainCategory.slug).map((slug: string) => (
                <a
                  href={`/knowledge/${slug}`}
                  class="px-4 py-2 rounded-full bg-white border border-stone-150/40 text-xs font-black uppercase tracking-wider text-emerald-800 hover:bg-emerald-50 hover:border-emerald-300 transition-all"
                >
                  {PILLARS[slug]?.name || slug}
                </a>
              ))}
            </div>
          </section>
        )}

        <section class="mt-16 pt-12 border-t border-stone-200">
          <div class="prose prose-emerald max-w-none text-stone-700 bg-white p-8 md:p-12 rounded-3xl border border-stone-150/40 shadow-sm space-y-6">
            <h2 class="text-2xl font-black text-emerald-950 brand-font">Clinical Significance & Overview of {props.mainCategory.name}</h2>
            <p class="leading-relaxed">
              Managing pathways within <strong>{props.mainCategory.name}</strong> forms a foundational pillar of precision metabolic medicine and evidence-graded clinical nutrition. In contemporary healthcare, optimizing this domain requires a comprehensive understanding of physiological homeostasis, molecular clearance, and systemic inflammatory pathways. Personalized protocols aim to align nutrient density, mineral loads, and bioactive compounds with the body's natural circadian rhythms to achieve optimal functional output. Clinical practitioners emphasize that cellular repair and metabolic regulation are highly dependent on the timing of nutrient delivery, which coordinates with internal clock genes. This clinical alignment is vital for maintaining metabolic homeostasis, regulating liver/kidney clearing processes, and preventing chronic cell-level degeneration.
            </p>
            <p class="leading-relaxed">
              By implementing targeted nutritional swaps under the guidance of registered clinical professionals, patients and practitioners can work together to protect organ function, regulate insulin response, and prevent disease progression. Our editorial board reviews primary clinical trials, biochemical pathways, and toxicological evidence to construct the guidance found across these index pages. Every clinical protocol is verified against standard-of-care recommendations and physiological clearance criteria to ensure patient safety and prevent metabolic overloading. Dosing schedules, mineral restrictions, and protein selections are adjusted dynamically based on individual metabolic thresholds and biomarker tracking. Furthermore, each protocol outlines detailed safety thresholds to prevent toxic mineral or protein accumulation in the blood.
            </p>
            <p class="leading-relaxed">
              Key targets include monitoring established biomarkers, optimizing daily hydration habits, avoiding common food-borne and environmental nephrotoxins, and timing meals to support metabolic efficiency. Integrative lifestyle changes, structured physical activity, and sleep hygiene constitute essential supporting interventions alongside standard-of-care medical therapies. In addition, patients should maintain routine communication with their metabolic care teams, including endocrinologists, nephrologists, or cardiologists, to coordinate care and ensure all pharmaceutical and nutritional protocols are fully synchronized. Through this collaborative, multi-faceted approach, we support patients in achieving long-term health preservation, tissue recovery, and overall quality of life. Establishing regular laboratory blood panel assessments (including eGFR and lipid profiles) provides the objective data required to tune these dietary interventions.
            </p>
            <p class="leading-relaxed">
              Furthermore, the integration of plant-based bioactives and functional phytonutrients represents a critical avenue for downregulating chronic inflammatory cascades. Research indicates that specific dietary compounds act as signaling molecules that upregulate cellular defense mechanisms, enhance mitochondrial efficiency, and improve endothelial function. Clinicians and patients are encouraged to study the individual ingredient and condition pages to understand these metabolic synergies and how to apply them safely in daily life. These protective synergies help prevent cellular damage and preserve active mitochondria across all organ groups.
            </p>
            <p class="leading-relaxed">
              Our unique <strong>Nutritional Color Code system (NutritionColours)</strong> further simplifies this integration by mapping visual dietary pigments—such as dark greens (chlorophyll), deep purples (anthocyanins), and bright oranges (carotenoids)—to their corresponding physiological targets and organ clearance pathways. This color-coded visual approach allows patients to construct balanced, bioavailable, and visually diverse meals that naturally maximize bioactive compound density while automatically remaining within safe clinical mineral and protein boundaries. This systematic layout guarantees that patients can easily audit their daily micronutrient density at a glance.
            </p>
            <p class="leading-relaxed">
              In conclusion, the clinical protocols, botanical profiles, and integrative swaps detailed across our databases provide a robust framework for supportive care. Regular monitoring of diagnostic parameters, compliance with evidence-graded nutrition plans, and routine collaboration with certified practitioners ensures a safe, personalized, and highly effective path toward metabolic optimization and systemic wellness.
            </p>
          </div>
        </section>
      </div>
    </main>
  )}

  {/* LEVEL 2: CATEGORY HUB */}
  {type === 'category' && (
    <main class="space-y-16 pb-24 bg-stone-50/50">
      <div class="bg-emerald-950 text-white pt-24 pb-16 px-6 relative overflow-hidden">
        <div class="max-w-7xl mx-auto space-y-4 relative z-10">
          <nav class="flex text-xs font-semibold text-emerald-300 mb-6 uppercase tracking-wider" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-2">
              <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
              <li><span class="mx-2 text-emerald-500">/</span></li>
              <li><a href="/knowledge" class="hover:text-white transition-colors">Knowledge</a></li>
              <li><span class="mx-2 text-emerald-500">/</span></li>
              <li><a href={`/knowledge/${props.category.mainCategory.slug}`} class="hover:text-white transition-colors">{props.category.mainCategory.name}</a></li>
              <li><span class="mx-2 text-emerald-500">/</span></li>
              <li><span class="text-white">{props.category.name}</span></li>
            </ol>
          </nav>
          
          <h1 class="text-4xl md:text-6xl font-black brand-font tracking-tight leading-[0.9]">
            {props.category.name}
          </h1>
          {props.category.techName && (
            <p class="text-lime-400 font-mono text-xs uppercase tracking-[0.2em]">{props.category.techName}</p>
          )}
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6">
        <div class="space-y-12">
          {props.category.subCategories.map((sub: any) => (
            <div class="space-y-6">
              <div class="flex items-baseline justify-between border-b border-stone-200 pb-3">
                <div class="flex items-baseline gap-3">
                  <h2 class="text-2xl font-black text-emerald-950 brand-font">
                    {sub.name}
                  </h2>
                  {sub.commonName && (
                    <span class="text-xs text-stone-500 italic">({sub.commonName})</span>
                  )}
                </div>
                <a 
                  href={`/knowledge/${props.category.mainCategory.slug}/${props.category.slug}/${sub.slug}`}
                  class="text-xs font-black uppercase tracking-widest text-emerald-700 hover:text-emerald-900 flex items-center gap-1"
                >
                  View All ({sub.articlesCount}) <Icons name="arrow-right" size={12} />
                </a>
              </div>

              <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {sub.articles.slice(0, 3).map((art: any) => (
                  <a
                    href={art.canonicalUrl}
                    class="bg-white border border-stone-100 p-6 rounded-2xl hover:border-emerald-200 hover:shadow-lg transition-all group block"
                  >
                    <h3 class="text-sm font-black text-emerald-950 group-hover:text-emerald-800 transition-colors line-clamp-1 mb-2">
                      {art.title}
                    </h3>
                    <p class="text-[10px] font-black uppercase tracking-wider text-stone-400 flex items-center gap-1">
                      Read Protocol <Icons name="arrow-right" size={10} class="group-hover:translate-x-1 transition-transform" />
                    </p>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <section class="mt-16 pt-12 border-t border-stone-200">
          <div class="prose prose-emerald max-w-none text-stone-700 bg-white p-8 md:p-12 rounded-3xl border border-stone-150/40 shadow-sm space-y-6">
            <h2 class="text-2xl font-black text-emerald-950 brand-font">Physiological Assessment & Clinical Guidance: {props.category.name}</h2>
            <p class="leading-relaxed">
              The index of subcategories under <strong>{props.category.name}</strong> represents a key clinical spectrum in contemporary metabolic science. Differentiating between stages of health and staging the severity of functional decline requires careful diagnostic workups, including laboratory chemistry, functional imaging, and symptomatic evaluations. Dynamic risk stratification helps identify patients who require rapid intervention or changes in their clinical support schedules. Using advanced screening tools, including ultrasonography and tissue biopsy markers, guarantees accurate classification before initiating therapy.
            </p>
            <p class="leading-relaxed">
