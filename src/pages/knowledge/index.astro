---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icons from '../../components/Icons.astro';
import BotanicalMotif from '../../components/ui/BotanicalMotif.astro';
import EvidenceBento from '../../components/ui/EvidenceBento.astro';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Knowledge', path: '/knowledge' },
];

const sections = [
  {
    title: 'Circadian nutrition guide',
    href: '/knowledge/circadian-nutrition',
    text: 'Diurnal insulin sensitivity, early time-restricted feeding windows, and nutrient timing grounded in published human trials.',
  },
  {
    title: 'Health conditions index',
    href: '/knowledge/health-conditions',
    text: 'Structured overview of all quarantined condition guides, publication criteria, and review pipeline status.',
  },
  {
    title: 'Health topics directory',
    href: '/knowledge/health-topics',
    text: 'General wellness, physiology, and nutrition topics awaiting substantive revision and expert review.',
  },
  {
    title: 'Botanical and culinary herbs',
    href: '/knowledge/herbs',
    text: 'Directory of herbs and botanical preparations held in quarantine pending evidence grading and safety verification.',
  },
  {
    title: 'Culinary and therapeutic spices',
    href: '/knowledge/spices',
    text: 'Bioactive spice compounds, culinary uses, and clinical research documentation under review.',
  },
  {
    title: 'Plant-based and vegan nutrition',
    href: '/knowledge/vegan',
    text: 'Nutritional completeness, supplementation requirements, and evidence-grounded plant-based meal guidance.',
  },
  {
    title: 'Nutrigenomics and personalized nutrition',
    href: '/knowledge/nutrigenomics',
    text: 'Gene-diet interactions, enzymatic polymorphisms, and personalized nutrition boundaries.',
  },
  {
    title: 'Drug-nutrient interactions',
    href: '/knowledge/drug-interactions',
    text: 'High-stakes clinical interactions between pharmaceuticals and dietary compounds.',
  },
  {
    title: 'Nutritional science glossary',
    href: '/knowledge/glossary',
    text: 'Definitions, biochemical pathways, and terminology used across our knowledge base.',
  },
  {
    title: 'Editorial policy and review standard',
    href: '/legal/editorial-policy',
    text: 'Our four-gate publication standard, conflict-of-interest rules, and evidence grading methodology.',
  },
];
---

<BaseLayout
  title="Knowledge directory | NutritionColours"
  description="Explore reviewed guides, topic directories, and editorial publication standards across the NutritionColours knowledge base."
  canonicalUrl="/knowledge"
  pageCategory="knowledge"
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 sm:py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Knowledge</li>
      </ol>
    </nav>

    <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800 dark:text-emerald-300">
      <BotanicalMotif name="leaf-branch" class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" />
      Evidence-Gated Library
    </div>

    <h1 class="mt-4 text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">
      Knowledge directory
    </h1>

    <p class="mt-6 max-w-3xl text-lg leading-relaxed text-stone-700 dark:text-stone-300">
      Only stable, clinically reviewed hubs are listed here. Thousands of legacy health drafts have been permanently removed from generated routes until each claim, citation, author identity, and review record can be verified.
    </p>

    <!-- Phase 7 Clinical Synthesis Bento Grid -->
    <EvidenceBento class="mt-12" />

    <div class="mt-16 pt-10 border-t border-stone-200 dark:border-stone-800">
      <h2 class="text-2xl sm:text-3xl font-black text-emerald-950 dark:text-emerald-50 brand-font">
        Knowledge library hubs
      </h2>
      <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
        Browse verified monographies, topic categories, and publication protocols.
      </p>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

      {sections.map((section) => {
        const isCircadian = section.href.includes('circadian');
        const isPolicy = section.href.includes('policy');
        const badgeLabel = isCircadian ? 'Active Guide · RCT Evidence' : isPolicy ? 'Governance Standard' : 'Directory Hub';
        const badgeColor = isCircadian
          ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/60 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700'
          : isPolicy
          ? 'bg-amber-100 text-amber-900 dark:bg-amber-900/60 dark:text-amber-300 border-amber-300 dark:border-amber-700'
          : 'bg-stone-100 text-stone-800 dark:bg-stone-800 dark:text-stone-300 border-stone-200 dark:border-stone-700';

        return (
          <a
            href={section.href}
            class="card-interactive group flex flex-col justify-between rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-7 shadow-sm hover:border-emerald-400 dark:hover:border-emerald-600 transition-all"
          >
            <div>
              <span class={`inline-block text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full border ${badgeColor} mb-4`}>
                {badgeLabel}
              </span>
              <h2 class="text-xl font-black text-emerald-950 dark:text-emerald-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">
                {section.title}
              </h2>
              <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                {section.text}
              </p>
            </div>
            <div class="mt-6 flex items-center gap-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-400 group-hover:gap-2.5 transition-all">
              <span>Explore section</span>
              <Icons name="arrow-right" size={12} class="group-hover:translate-x-0.5 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
