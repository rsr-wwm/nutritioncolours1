---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../lib/topics';

// NOTE: this page previously rendered <HealthTopicPage client:load /> with no `topicId` or
// `navigate` prop — HealthTopicPage is a single-topic detail view (see src/pages/topic/[topic_id].astro
// for the real per-topic route), so this index page was broken (missing required props,
// would throw at runtime). Replaced with a real listing that links to each topic's own page.
const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
const topicsSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "url": `${SITE_URL}/knowledge/health-topics`,
  "name": "Diseases & Conditions Library",
  "description": "Clinical metabolic library detailing natural reversal approaches, nutritional science, and protocols for chronic conditions."
};
const categories = [...new Set(TOPICS.map((t) => t.category))];
---
<BaseLayout
  title="Diseases | Metabolic & Circadian Nutrition"
  description="Clinical metabolic library detailing natural reversal approaches, nutritional science, and protocols for chronic conditions."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(topicsSchema)} />
  <div class="max-w-7xl mx-auto px-6 py-16 space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="text-4xl md:text-5xl font-black text-emerald-950 brand-font">Diseases</h1>
      <p class="text-stone-600 leading-relaxed">
        {TOPICS.length}+ clinical protocols covering metabolic, cardiovascular, hormonal, and
        circadian health topics — each reviewed against peer-reviewed evidence.
      </p>
    </div>

    {categories.map((category) => (
      <div class="space-y-6">
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-emerald-700 border-l-4 border-lime-400 pl-4">
          {category}
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {TOPICS.filter((t) => t.category === category).map((topic) => (
            <a href={`/topic/${topic.id}`} class="bg-white border border-stone-100 p-5 rounded-2xl hover:border-emerald-200 hover:shadow-lg transition-all group block">
              <h3 class="text-xs font-black text-emerald-950 uppercase tracking-tight leading-tight group-hover:text-emerald-700 transition-colors">{topic.title}</h3>
            </a>
          ))}
        </div>
      </div>
    ))}

    <section class="mt-20 pt-16 border-t border-stone-200 dark:border-stone-850">
      <div class="prose prose-emerald max-w-none text-stone-700 dark:text-stone-300 bg-white dark:bg-stone-900 p-8 md:p-12 rounded-[40px] border border-stone-150/40 dark:border-stone-850/60 shadow-sm space-y-6">
        <h2 class="text-2xl font-black text-emerald-950 dark:text-white brand-font">Evidence-Graded Protocols for Disease Reversal</h2>
        <p class="leading-relaxed">
          The chronic diseases listed in our library represent the most prevalent challenges to human metabolic and circadian health. Conditions such as cardiovascular disease, metabolic syndrome, fatty liver, and hormonal imbalances are often closely linked to systemic insulin resistance and cellular energy deficits. Our protocols emphasize a root-cause approach that focuses on restoring homeostatic balance through precision clinical nutrition, target botanical compounds, and meal timing aligned with circadian biological rhythms.
        </p>
        <p class="leading-relaxed">
          Each monograph in our database undergoes a strict, multi-stage review process by registered dietitians and clinical nutritionists. We score every claim using an evidence-graded hierarchy, ranking recommendations from Level A (validated by clinical trials) to Level D (based on historical consensus and expert panels). This process ensures that all dietary suggestions, botanical swaps, and hydration schedules are clinically safe and free from unqualified assertions. By focusing on visual dietary pigments through the <strong>Nutritional Color Code system (NutritionColours)</strong>, we help patients select nutrient-dense whole foods that naturally support specific clearance and detoxification pathways.
        </p>
        <p class="leading-relaxed">
          We encourage patients to work closely with their medical specialists to track key biomarkers—such as blood panels, lipid profiles, thyroid panels, and glycemic trends. By combining routine diagnostic testing with personalized, evidence-graded lifestyle swaps, patients can safely manage, support, and work toward reversing chronic metabolic decline.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
