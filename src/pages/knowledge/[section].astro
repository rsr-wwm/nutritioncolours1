---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const sections = [
    { slug: 'blogs', label: 'Articles', scope: 'article authorship, citations, claims, and review records' },
    { slug: 'drug-interactions', label: 'Drug–nutrient interactions', scope: 'pharmacist review, source currency, contraindications, and escalation guidance' },
    { slug: 'glossary', label: 'Health glossary', scope: 'definitions, sources, terminology, and linked claims' },
    { slug: 'health-conditions', label: 'Health conditions', scope: 'medical claims, evidence grading, authorship, and clinical review' },
    { slug: 'health-topics', label: 'Health topics', scope: 'medical claims, citations, authorship, and clinical review' },
    { slug: 'herbs', label: 'Herbs', scope: 'identity, dosing language, interactions, contraindications, and evidence quality' },
    { slug: 'nutrigenomics', label: 'Nutrigenomics', scope: 'variant interpretation, clinical validity, privacy, and genetics review' },
    { slug: 'spices', label: 'Spices', scope: 'identity, health claims, interactions, contraindications, and evidence quality' },
    { slug: 'vegan', label: 'Plant-based guides', scope: 'nutrient adequacy, life-stage guidance, citations, and dietitian review' },
  ];
  return sections.map((section) => ({ params: { section: section.slug }, props: { section } }));
}

const { section } = Astro.props;
---

<BaseLayout
  title={`${section.label} under review | NutritionColours`}
  description={`${section.label} drafts are unavailable while ${section.scope} are verified.`}
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Knowledge', path: '/knowledge' },
    { name: `${section.label} review`, path: `/knowledge/${section.slug}` },
  ]}
>
  <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <div class="inline-flex items-center gap-2 rounded-full border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300">
      <span class="inline-block h-2 w-2 rounded-full bg-amber-500 animate-pulse" aria-hidden="true"></span>
      Content Safeguard · Active Review
    </div>

    <h1 class="mt-4 text-4xl md:text-5xl font-black text-emerald-950 dark:text-emerald-50 brand-font tracking-tight">
      {section.label} are under review
    </h1>

    <p class="mt-6 text-lg leading-relaxed text-stone-700 dark:text-stone-300 border-l-4 border-amber-400 dark:border-amber-500 pl-5">
      Earlier drafts are unavailable while {section.scope} are checked. This page is excluded from search indexing and contains no individual health recommendation.
    </p>

    <!-- 4-Stage Editorial Verification Stepper -->
    <section class="mt-10 rounded-3xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 md:p-8 shadow-sm" aria-labelledby="verification-pipeline-heading">
      <h2 id="verification-pipeline-heading" class="text-xl font-black text-emerald-950 dark:text-emerald-100">
        4-Stage Editorial Verification Pipeline
      </h2>
      <p class="mt-2 text-sm text-stone-600 dark:text-stone-400">
        Before any guide in this section is published, it must pass 4 consecutive independent verification gates:
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="relative rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-800/50 p-4">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-xs font-black text-emerald-800 dark:text-emerald-300 mb-2">1</span>
          <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">Literature Audit</h3>
          <p class="mt-1 text-xs leading-relaxed text-stone-600 dark:text-stone-400">Primary peer-reviewed RCTs and clinical systematic reviews indexed with PubMed/DOI.</p>
        </div>

        <div class="relative rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-800/50 p-4">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-xs font-black text-emerald-800 dark:text-emerald-300 mb-2">2</span>
          <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">Clinical Review</h3>
          <p class="mt-1 text-xs leading-relaxed text-stone-600 dark:text-stone-400">Named professional reviewer verifies clinical safety boundaries and life-stage contraindications.</p>
        </div>

        <div class="relative rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-800/50 p-4">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-xs font-black text-emerald-800 dark:text-emerald-300 mb-2">3</span>
          <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">Legal Scope</h3>
          <p class="mt-1 text-xs leading-relaxed text-stone-600 dark:text-stone-400">Compliance with ASCI, MeitY, and non-prescriptive educational boundary governance.</p>
        </div>

        <div class="relative rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-800/50 p-4">
          <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-xs font-black text-emerald-800 dark:text-emerald-300 mb-2">4</span>
          <h3 class="text-sm font-bold text-stone-900 dark:text-stone-100">Ledger Lock</h3>
          <p class="mt-1 text-xs leading-relaxed text-stone-600 dark:text-stone-400">Claims registered in immutable ledger before build gate permits page generation.</p>
        </div>
      </div>
    </section>

    <!-- Publication Requirements List -->
    <section class="mt-8 rounded-3xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/60 dark:bg-amber-950/30 p-6 md:p-8 text-sm leading-relaxed text-amber-950 dark:text-amber-200" aria-labelledby="publication-requirements">
      <h2 id="publication-requirements" class="font-bold text-base text-amber-950 dark:text-amber-100">Mandatory requirements before republication</h2>
      <ul class="mt-3 list-disc space-y-2 pl-5 text-stone-700 dark:text-stone-300">
        <li>Named, accountable author and reviewer with verified professional identity and relevant clinical credentials.</li>
        <li>Claim-level support from current primary or authoritative peer-reviewed sources with active DOIs.</li>
        <li>Explicit uncertainty, contraindication, drug interaction, and emergency escalation boundaries.</li>
        <li>Independent editorial review with recorded review timestamps, version logs, and renewal triggers.</li>
      </ul>
    </section>

    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold">
      <a href="/knowledge" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-5 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors">
        Return to knowledge directory
      </a>
      <a href="/legal/editorial-policy" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-5 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 dark:hover:border-emerald-500 transition-colors">
        Read the editorial policy
      </a>
    </div>
  </article>
</BaseLayout>
