---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationGate from '../components/PublicationGate.astro';
import NotifyMeForm from '../components/NotifyMeForm.astro';
import Icons from '../components/Icons.astro';

const gateItems = [
  { title: 'Primary Credential Verification', text: 'Accredited degree verification and current registration with relevant professional councils.' },
  { title: 'Conflict-of-Interest Disclosures', text: 'Mandatory declaration of any pharmaceutical, commercial supplement, or clinic affiliations.' },
  { title: 'Explicit Written Consent', text: 'Signed, revocable agreement approving the specific biographical and professional copy.' },
  { title: 'Documented Editorial Trail', text: 'Immutable ledger recording review timestamps, verified claims, and renewal deadlines.' },
];
---

<BaseLayout
  title="Contributor Verification | NutritionColours"
  description="Contributor profiles are unavailable while identity, credentials, roles, and disclosures are independently verified."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Contributor verification', path: '/team' },
  ]}
>
  <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Team verification</li>
      </ol>
    </nav>

    <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300">
      <span class="inline-block h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
      Identity Safeguard &middot; Active Verification Gate
    </div>

    <h1 class="mt-4 text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">
      Contributor profiles are under verification
    </h1>

    <p class="mt-6 text-lg leading-relaxed text-stone-700 dark:text-stone-300 border-l-4 border-amber-400 dark:border-amber-500 pl-5">
      Individual contributor and clinician profiles have been temporarily withdrawn from indexing until legal identity, professional registrations, accredited degrees, organizational roles, and conflict-of-interest declarations are independently audited.
    </p>

    <PublicationGate
      heading="4-Point Author & Reviewer Verification Protocol"
      description="Before an author or medical reviewer profile is published with structured schema, the following four gates must be verified:"
      numberPrefix="Standard"
      items={gateItems}
    />

    <!-- Worked example callout card -->
    <div class="mt-8 rounded-2xl border border-emerald-200/90 dark:border-emerald-800/80 bg-emerald-50/60 dark:bg-emerald-950/30 p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Published Reference Preview</span>
        <p class="text-sm text-stone-700 dark:text-stone-300">
          Want to see how an evidence-gated reference looks once verified with human trial citations?
        </p>
      </div>
      <a href="/knowledge/circadian-nutrition" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-5 py-2.5 text-xs font-bold text-white hover:bg-emerald-800 dark:hover:bg-emerald-600 transition-colors whitespace-nowrap self-start sm:self-center shadow-xs">
        <span>Circadian Nutrition Guide</span>
        <Icons name="arrow-right" size={14} />
      </a>
    </div>

    <NotifyMeForm topic="contributor profiles" />

    <!-- Disclaimers & Action Buttons -->
    <div class="mt-8 rounded-2xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/70 dark:bg-amber-950/30 p-6 text-sm leading-relaxed text-amber-950 dark:text-amber-200">
      No clinical licensure, hospital affiliation, or individual consulting capacity should be inferred from legacy drafts.
    </div>

    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold">
      <a href="/legal/editorial-policy" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-6 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors">
        Read editorial policy
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Contact editorial desk
      </a>
    </div>
  </article>
</BaseLayout>
