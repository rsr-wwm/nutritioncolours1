---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationGate from '../components/PublicationGate.astro';
import NotifyMeForm from '../components/NotifyMeForm.astro';

const gateItems = [
  { title: 'Legal & Clinical Scope Audit', text: 'Formal boundary definition complying with telemedicine practice regulations.' },
  { title: 'Practitioner Identity Verification', text: 'Independently certified medical qualifications and professional registrations.' },
  { title: 'Transparent Terms & Pricing', text: 'Unambiguous refund policies, transparent fees, and tested cancellation flows.' },
  { title: 'DPDP-Compliant Intake', text: 'End-to-end encrypted biometric and health data collection architecture.' },
  { title: 'Emergency & Escalation Protocols', text: 'Explicit incident handling and acute care redirection workflows.' },
];
---

<BaseLayout
  title="Online program details pending review | NutritionColours"
  description="Online service details remain unpublished while scope, credentials, pricing, terms, privacy and operations are verified."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Programs', path: '/plans' },
  ]}
>
  <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Programs</li>
      </ol>
    </nav>

    <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300">
      <span class="inline-block h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
      Service Safeguard &middot; Active Gate
    </div>

    <h1 class="mt-4 text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">
      Program details are not yet published
    </h1>

    <p class="mt-6 text-lg leading-relaxed text-stone-700 dark:text-stone-300 border-l-4 border-amber-400 dark:border-amber-500 pl-5">
      NutritionColours describes its services as online-only. However, specific program curriculum, pricing structures, intake questionnaires, and practitioner assignments remain withdrawn until verified. No commercial purchase, clinical intake, or treatment transaction is offered through this website.
    </p>

    <PublicationGate
      heading="5 Mandatory prerequisites before republication"
      description="Every prerequisite below must clear independent legal and clinical review before this page returns:"
      numberPrefix="Gate"
      items={gateItems}
    />

    <NotifyMeForm topic="online program details" />

    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold">
      <a href="/services/online-nutrition" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-6 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors">
        Read online service status
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Contact the publisher
      </a>
    </div>
  </article>
</BaseLayout>
