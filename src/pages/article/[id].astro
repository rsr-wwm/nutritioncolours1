---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HealthTopicPage as ArticleClientPage } from '../../components/HealthTopicPage';
import { BLOG_ARTICLES } from '../../lib/constants';

export async function getStaticPaths() {
  return BLOG_ARTICLES.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;

// Set Edge-Level Caching headers
Astro.response.headers.set('Cache-Control', 'public, max-age=86400, s-maxage=604800, stale-while-revalidate=3600');

// Construct rich keywords
const allKeywords = [
  article.category,
  "Metabolic Article",
  article.title,
  ...(article.tags || [])
];

const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "url": `${SITE_URL}/article/${article.id}`,
  "name": `${article.title} | NutritionColours`,
  "description": article.excerpt,
  "datePublished": article.date,
  "author": {
    "@type": "Person",
    "name": article.author
  }
};
---

<BaseLayout
  title={`${article.title} | NutritionColours`}
  description={article.excerpt}
  keywords={allKeywords}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  
  <ArticleClientPage
    client:load
    topicId={article.id}
    navigate={(path) => { if (typeof globalThis !== 'undefined' && globalThis.window) globalThis.window.location.href = '/' + path; }}
  />

  {/* Rich Server-Rendered Article Container (SEO / AEO / AIO / View-Source Law) */}
  <div class="max-w-4xl mx-auto px-6 pb-24 -mt-12">
    <article class="prose prose-emerald max-w-none text-stone-700 bg-white p-8 md:p-12 rounded-[40px] border border-stone-150/40 shadow-sm space-y-8">
      
      <div class="space-y-4 border-b border-stone-100 pb-6">
        <span class="px-3 py-1 bg-emerald-50 text-emerald-800 text-[10px] font-black uppercase tracking-widest rounded-full inline-flex items-center gap-1.5 shadow-sm border border-emerald-100">
          📄 {article.category} Journal Paper
        </span>
        <h2 class="text-3xl md:text-4xl font-black text-emerald-950 brand-font leading-tight m-0">
          {article.title}
        </h2>
        <div class="flex items-center gap-4 text-xs text-stone-500 font-bold">
          <span>By {article.author}</span>
          <span>•</span>
          <span>Published on {article.date}</span>
        </div>
      </div>

      <div class="text-stone-700 text-sm leading-relaxed whitespace-pre-line space-y-4 font-semibold" data-ai-answer="true">
        {article.content.replace(/<!--[\s\S]*?-->/g, '')}
      </div>

      {/* General Health Disclaimer to maintain YMYL compliance */}
      <div class="bg-stone-50 border border-stone-100 p-6 rounded-3xl space-y-2 mt-8">
        <span class="text-[10px] font-black uppercase tracking-widest text-emerald-800 block">Editorial Note & Disclaimer</span>
        <p class="text-xs leading-relaxed text-stone-500 m-0">
          The content of this article is intended for educational and information purposes only. All clinical programs and circadian swaps must be implemented under the direct supervision of certified healthcare professionals or registered dietitians. Do not alter or cease any prescribed medication without first consulting your doctor.
        </p>
      </div>

    </article>
  </div>
</BaseLayout>
