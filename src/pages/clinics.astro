---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icons from '../components/Icons.astro';
---

<BaseLayout
  title="No physical clinics | NutritionColours"
  description="NutritionColours is online-only and does not represent physical clinics, offices, diagnostic centres, or city branches."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Service information', path: '/clinics' },
  ]}
>
  <article class="mx-auto max-w-4xl px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Service notice</li>
      </ol>
    </nav>

    <div class="mt-6 inline-flex items-center gap-2 rounded-full border border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900 dark:text-amber-300">
      <span class="inline-block h-2 w-2 rounded-full bg-amber-500" aria-hidden="true"></span>
      Permanent Retraction &middot; Online-Only Platform
    </div>

    <h1 class="mt-4 brand-font text-fluid-hero font-black text-emerald-950 dark:text-emerald-50">
      No physical clinics or city branches
    </h1>

    <p class="mt-6 text-lg leading-8 text-stone-700 dark:text-stone-300 border-l-4 border-amber-400 dark:border-amber-500 pl-5">
      NutritionColours is strictly an online-only platform. We do not operate customer-facing physical offices, walk-in clinics, diagnostic centres, or geographic branch networks. All legacy locality drafts have been permanently retracted under HTTP 410 Gone tombstones.
    </p>

    <!-- Boundary Warning Card -->
    <section class="card-interactive mt-10 rounded-3xl border border-amber-200 dark:border-amber-800/60 bg-amber-50/70 dark:bg-amber-950/30 p-7 md:p-8 text-amber-950 dark:text-amber-200 space-y-4" aria-labelledby="boundary-heading">
      <div class="flex items-center gap-2.5">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-amber-200/80 dark:bg-amber-900/60 text-amber-900 dark:text-amber-100 border border-amber-300 dark:border-amber-700/80 text-sm font-black" aria-hidden="true">
          <Icons name="alert-triangle" size={16} />
        </span>
        <h2 id="boundary-heading" class="text-xl font-black text-amber-950 dark:text-amber-100 brand-font">Important notice before contacting us</h2>
      </div>
      <ul class="list-disc space-y-2.5 pl-5 text-sm leading-relaxed text-stone-700 dark:text-stone-300">
        <li>Do not send confidential medical records, diagnostic laboratory reports, or urgent acute health details through email or messaging apps.</li>
        <li>This website does not provide acute emergency services, prescription pharmacology, or individual diagnostic evaluation.</li>
        <li>For individualized health decisions or urgent concerns, continue working directly with an appropriately qualified local medical practitioner.</li>
      </ul>
    </section>

    <div class="mt-10 flex flex-wrap gap-4 text-sm font-bold">
      <a href="/services/online-nutrition" class="inline-flex items-center gap-2 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-6 py-3 text-white hover:bg-emerald-800 dark:hover:bg-emerald-800 transition-colors">
        Online service status
      </a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        General contact
      </a>
      <a href="/legal/privacy" class="inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-800 px-6 py-3 text-stone-800 dark:text-stone-200 hover:border-emerald-600 transition-colors">
        Privacy notice
      </a>
    </div>
  </article>
</BaseLayout>
