---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import Icons from '../components/Icons.astro';

const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
const homePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE_URL}/#webpage`,
  url: `${SITE_URL}/`,
  name: 'NutritionColours — Food and nutrition education',
  description: 'Food and recipe directories, publication policies, and transparent review-status notices.',
  isPartOf: { '@id': `${SITE_URL}/#website` },
};

const sections = [
  { href: '/foods', title: 'Food guides', text: 'Browse verified food profiles and general nutrition information.', icon: 'leaf', accent: 'content' },
  { href: '/recipes', title: 'Recipe ideas', text: 'Explore wholesome recipe ideas with ingredients and preparation steps.', icon: 'utensils', accent: 'content' },
  { href: '/knowledge/circadian-nutrition', title: 'Circadian health', text: 'Examine diurnal metabolic timing, insulin sensitivity, and chrono-nutrition.', icon: 'refresh', accent: 'content' },
  { href: '/knowledge/health-topics', title: 'Health-content status', text: 'See why legacy health drafts are unavailable and what review is required.', icon: 'shield-check', accent: 'status' },
  { href: '/legal/methodology', title: 'Methodology', text: 'See how content, claims, sources, updates, and corrections are handled.', icon: 'search', accent: 'status' },
  { href: '/legal/editorial-policy', title: 'Editorial policy', text: 'Review rules for authorship, sourcing, clinical review, and corrections.', icon: 'file-text', accent: 'status' },
];
---
<BaseLayout
  title="NutritionColours — Food and nutrition education"
  description="Food and recipe directories, publication policies, and transparent review-status notices."
>
  <JsonLd data={homePageSchema} />

  <!-- Hero Section with Dual-Column Visual Balance -->
  <section class="relative overflow-hidden max-w-7xl mx-auto px-6 pt-16 pb-20 lg:pt-24 lg:pb-28">
    <!-- Decorative accent: soft organic blobs, purely ornamental -->
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="absolute -top-24 -right-24 h-80 w-80 rounded-full bg-emerald-200/40 dark:bg-emerald-900/20 blur-3xl"></div>
      <div class="absolute top-1/3 -left-28 h-72 w-72 rounded-full bg-amber-100/50 dark:bg-amber-900/10 blur-3xl"></div>
      <svg class="absolute right-4 top-6 h-24 w-24 text-emerald-700/10 dark:text-emerald-300/10 hidden lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C10.9 14.36 12 15 12 15"/>
      </svg>
    </div>

    <div class="relative grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 dark:border-emerald-800/80 bg-emerald-50 dark:bg-emerald-950/60 px-4 py-1.5 text-xs font-bold text-emerald-800 dark:text-emerald-300">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400"></span>
          <span>Independent Educational Resource</span>
        </div>
        
        <h1 class="text-fluid-hero font-black text-emerald-950 dark:text-emerald-50 brand-font">
          Understand food and nutrition with clearer context.
        </h1>
        
        <p class="text-lg md:text-xl leading-relaxed text-stone-600 dark:text-stone-300 max-w-2xl">
          NutritionColours provides evidence-grounded food guides, recipe collections, and transparent review-status records. All content is built to educate, not to replace care from a qualified healthcare professional.
        </p>
        
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="/foods" class="inline-flex items-center gap-2.5 rounded-xl bg-emerald-900 dark:bg-emerald-700 px-6 py-3.5 text-sm font-bold text-white shadow-md hover:bg-emerald-800 dark:hover:bg-emerald-800 hover:shadow-lg transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]">
            <span>Browse food guides</span>
            <Icons name="arrow-right" size={16} />
          </a>
          <a href="/search" class="inline-flex items-center gap-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-6 py-3.5 text-sm font-bold text-emerald-950 dark:text-emerald-200 hover:border-emerald-500 hover:bg-stone-50 dark:hover:bg-stone-800 transition-all">
            <span>Search the library</span>
            <Icons name="search" size={16} />
          </a>
        </div>
      </div>

      <!-- High-Trust Visual Synthesis Card -->
      <div class="lg:col-span-5">
        <div class="card-interactive rounded-3xl border border-stone-200/80 dark:border-stone-800 bg-white dark:bg-stone-900/90 p-7 shadow-xl space-y-5 transition-all">
          <div class="flex items-center justify-between border-b border-stone-100 dark:border-stone-800 pb-4">
            <span class="text-xs font-black uppercase tracking-wider text-emerald-700 dark:text-emerald-400">Editorial Standard</span>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100/70 dark:bg-emerald-950 px-2.5 py-0.5 text-[11px] font-bold text-emerald-800 dark:text-emerald-300">
              <span>● Active Verification</span>
            </span>
          </div>
          
          <div class="space-y-3.5 text-xs sm:text-sm">
            <div class="flex items-start gap-3 rounded-xl bg-stone-50 dark:bg-stone-800/60 p-3.5">
              <span class="text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" aria-hidden="true">
                <Icons name="check" size={16} />
              </span>
              <div>
                <strong class="text-stone-900 dark:text-stone-100 block">Evidence-Gated Claims</strong>
                <span class="text-stone-600 dark:text-stone-400 text-xs">All claims cross-checked against peer-reviewed PubMed trials.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-stone-50 dark:bg-stone-800/60 p-3.5">
              <span class="text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" aria-hidden="true">
                <Icons name="check" size={16} />
              </span>
              <div>
                <strong class="text-stone-900 dark:text-stone-100 block">No Commercial Endorsements</strong>
                <span class="text-stone-600 dark:text-stone-400 text-xs">Zero sponsored rankings, miracle cure claims, or doorway spam.</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-xl bg-stone-50 dark:bg-stone-800/60 p-3.5">
              <span class="text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" aria-hidden="true">
                <Icons name="check" size={16} />
              </span>
              <div>
                <strong class="text-stone-900 dark:text-stone-100 block">Online-Only Education</strong>
                <span class="text-stone-600 dark:text-stone-400 text-xs">Transparent telehealth status without physical clinic misrepresentations.</span>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <a href="/legal/methodology" class="block w-full text-center rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/50 dark:bg-emerald-950/40 py-2.5 text-xs font-bold text-emerald-800 dark:text-emerald-300 hover:bg-emerald-100/50 dark:hover:bg-emerald-900/50 transition-colors">
              Read our full methodology &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorized Library Grid -->
  <section aria-labelledby="explore-heading" class="bg-stone-50/70 dark:bg-stone-950/60 border-y border-stone-200/80 dark:border-stone-800 py-20 transition-colors">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-2xl">
        <p class="text-xs font-black uppercase tracking-[0.25em] text-emerald-700 dark:text-emerald-400">Library Sections</p>
        <h2 id="explore-heading" class="mt-2 text-3xl sm:text-4xl font-black text-emerald-950 dark:text-emerald-50 brand-font">
          Explore educational resources
        </h2>
        <p class="mt-3 text-stone-600 dark:text-stone-300 text-base">
          Navigate verified food profiles, culinary recipe ideas, and transparent publishing policy documentation.
        </p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((section) => (
          <a
            href={section.href}
            class="card-interactive group rounded-3xl border border-stone-200/80 dark:border-stone-800 bg-white dark:bg-stone-900 p-7 shadow-sm hover:border-emerald-300 dark:hover:border-emerald-700 transition-all"
          >
            <span
              class:list={[
                'inline-flex h-12 w-12 items-center justify-center rounded-2xl group-hover:scale-110 transition-transform',
                section.accent === 'status'
                  ? 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300'
                  : 'bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300',
              ]}
              aria-hidden="true"
            >
              <Icons name={section.icon} size={22} />
            </span>
            <h3 class="mt-5 text-xl font-black text-emerald-950 dark:text-emerald-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors">
              {section.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              {section.text}
            </p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-400 group-hover:underline">
              <span>Explore section</span>
              <Icons name="arrow-right" size={12} class="group-hover:translate-x-0.5 transition-transform" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Clinical Safety & Patient Boundary Section -->
  <section aria-labelledby="safety-heading" class="max-w-7xl mx-auto px-6 py-20">
    <div class="card-interactive rounded-3xl border border-amber-300/80 dark:border-amber-700/80 bg-gradient-to-r from-amber-50 to-amber-100/40 dark:from-amber-950/30 dark:to-stone-900 p-8 md:p-10 max-w-4xl shadow-sm">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-amber-200/80 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 border border-amber-300 dark:border-amber-700/80" aria-hidden="true">
          <Icons name="alert-triangle" size={20} />
        </span>
        <h2 id="safety-heading" class="text-2xl font-black text-amber-950 dark:text-amber-100">
          Use health information safely
        </h2>
      </div>
      <p class="mt-4 leading-relaxed text-amber-950/90 dark:text-amber-200/90 text-sm sm:text-base">
        Do not delay urgent clinical care, change prescription medications, or initiate treatment regimens based on this website. Always consult with a licensed medical practitioner for individual health concerns and diagnostics.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs sm:text-sm font-bold">
        <a href="/legal/editorial-policy" class="text-amber-950 dark:text-amber-200 underline underline-offset-4 hover:text-amber-800 dark:hover:text-white">
          Read our editorial safeguard policy &rarr;
        </a>
        <span class="text-amber-400 dark:text-amber-600" aria-hidden="true">•</span>
        <a href="/services/online-nutrition" class="text-amber-950 dark:text-amber-200 underline underline-offset-4 hover:text-amber-800 dark:hover:text-white">
          Review online service boundaries &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
