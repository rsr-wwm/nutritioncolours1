---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
---

<BaseLayout 
  title="Search the knowledge library | NutritionColours" 
  description="Search the currently published NutritionColours pages and policies. Unreviewed health, food, and recipe drafts are excluded."
  noindex={true}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Search', path: '/search' },
  ]}
>
  <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-600 dark:text-stone-400 mb-8">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="font-bold text-emerald-800 dark:text-emerald-400 hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-stone-900 dark:text-stone-200">Search</li>
      </ol>
    </nav>

    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-300 dark:border-emerald-800 bg-emerald-50 dark:bg-emerald-950/40 px-3.5 py-1 text-xs font-bold uppercase tracking-widest text-emerald-800 dark:text-emerald-300">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Fast Static Search
      </div>
      <h1 class="mt-4 text-4xl md:text-5xl font-black text-emerald-950 dark:text-emerald-50 brand-font tracking-tight">
        Search the knowledge library
      </h1>
      <p class="text-stone-600 dark:text-stone-400 mt-3 max-w-2xl mx-auto text-base">
        Search currently published educational pages and editorial policies. Unreviewed drafts remain excluded.
      </p>

      <!-- Popular Topic Chips -->
      <div class="mt-6 flex flex-wrap justify-center items-center gap-2 text-sm">
        <span class="font-semibold text-stone-500 dark:text-stone-400">Popular hubs:</span>
        <a href="/knowledge/circadian-nutrition" class="inline-flex min-h-11 items-center rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 px-4 py-2 font-semibold text-stone-700 dark:text-stone-300 hover:border-emerald-500 transition-colors">
          Circadian Nutrition
        </a>
        <a href="/foods" class="inline-flex min-h-11 items-center rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 px-4 py-2 font-semibold text-stone-700 dark:text-stone-300 hover:border-emerald-500 transition-colors">
          Food Library
        </a>
        <a href="/legal/editorial-policy" class="inline-flex min-h-11 items-center rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 px-4 py-2 font-semibold text-stone-700 dark:text-stone-300 hover:border-emerald-500 transition-colors">
          Editorial Standard
        </a>
        <a href="/knowledge" class="inline-flex min-h-11 items-center rounded-full border border-stone-200 dark:border-stone-700 bg-stone-100 dark:bg-stone-800 px-4 py-2 font-semibold text-stone-700 dark:text-stone-300 hover:border-emerald-500 transition-colors">
          Knowledge Directory
        </a>
      </div>
    </div>
    
    <div class="bg-white dark:bg-stone-900 rounded-3xl p-6 md:p-8 shadow-xl border border-stone-200 dark:border-stone-800">
      <Search className="pagefind-ui w-full" />
      <noscript>
        <div class="rounded-2xl border border-amber-200 bg-amber-50 dark:bg-amber-950/40 dark:border-amber-800 p-5 text-sm text-amber-950 dark:text-amber-200">
          Search requires JavaScript. You can still browse the <a class="font-bold underline" href="/knowledge">knowledge directory</a>, <a class="font-bold underline" href="/foods">food directory</a>, or <a class="font-bold underline" href="/sitemap">site index</a>.
        </div>
      </noscript>
    </div>
  </div>
  
  <style is:global>
    /* astro-pagefind renders Pagefind's component UI in the light DOM. These are
       its --pf-* variables, not the older Pagefind UI's --pagefind-ui-* API. */
    pagefind-searchbox.pagefind-ui {
      --pf-font: var(--font-sans);
      --pf-text: var(--text-primary);
      --pf-text-secondary: var(--text-muted);
      --pf-text-muted: var(--text-muted);
      --pf-background: var(--surface-card);
      --pf-border: var(--surface-border);
      --pf-border-focus: var(--focus-ring);
      --pf-hover: var(--surface-subtle);
      --pf-mark: var(--text-primary);
      --pf-outline-focus: var(--focus-ring);
      --pf-outline-width: 2px;
      --pf-outline-offset: 3px;
      --pf-border-radius: 0.75rem;
      --pf-input-height: 44px;
      --pf-searchbox-max-width: 100%;
    }

    pagefind-searchbox.pagefind-ui .pf-searchbox-input {
      min-height: 44px;
      font-weight: 500;
    }

    /* This searchbox has no clear button today. The selector covers one if the
       component adds it, without changing its current keyboard shortcut hint. */
    pagefind-searchbox.pagefind-ui .pf-input-clear {
      min-width: 44px;
      min-height: 44px;
    }

    pagefind-searchbox.pagefind-ui .pf-searchbox-result-title {
      font-family: var(--font-display);
      font-weight: 900 !important;
      font-size: 1rem !important;
    }

    pagefind-searchbox.pagefind-ui .pf-searchbox-result-excerpt {
      font-size: 0.875rem !important;
      line-height: 1.5;
    }
  </style>
</BaseLayout>
