---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout 
  title="Search | NutritionColours" 
  description="Search for clinical nutrition insights, recipes, diseases, and botanical protocols."
>
  <div class="max-w-4xl mx-auto px-6 pt-32 pb-24 min-h-[70vh]">
    <div class="text-center mb-12">
      <SectionHeading subtitle="DISCOVERY" title="Search Medical Knowledge Base" />
      <p class="text-stone-600 dark:text-stone-300 mt-4 max-w-2xl mx-auto">
        Search our extensive database of nutrigenomics, drug interactions, clinical protocols, and evidence-based recipes.
      </p>
    </div>
    
    <div class="bg-white dark:bg-stone-900 rounded-3xl p-8 shadow-2xl border border-stone-100 dark:border-stone-800">
      <Search className="pagefind-ui w-full" />
    </div>
  </div>
  
  <style is:global>
    /* Customizing Pagefind UI to match our design system */
    .pagefind-ui {
      --pagefind-ui-scale: 1;
      --pagefind-ui-primary: #064e3b; /* emerald-900 */
      --pagefind-ui-text: #292524;
      --pagefind-ui-background: #ffffff;
      --pagefind-ui-border: #f5f5f4;
      --pagefind-ui-tag: #ecfdf5;
      --pagefind-ui-border-width: 2px;
      --pagefind-ui-border-radius: 12px;
      --pagefind-ui-image-border-radius: 8px;
      --pagefind-ui-image-box-ratio: 3 / 2;
      --pagefind-ui-font: 'Inter', sans-serif;
    }
    
    .dark .pagefind-ui {
      --pagefind-ui-primary: #a3e635; /* lime-400 */
      --pagefind-ui-text: #ecfdf5;
      --pagefind-ui-background: #1c1917; /* stone-900 */
      --pagefind-ui-border: #292524;
      --pagefind-ui-tag: #064e3b;
    }
    
    .pagefind-ui .pagefind-ui__search-input {
      font-weight: 500;
      padding-left: 3rem;
    }
    
    .pagefind-ui .pagefind-ui__search-clear {
      padding: 0 1rem;
    }
    
    .pagefind-ui .pagefind-ui__result-title {
      font-family: 'Fraunces', serif;
      font-weight: 800;
    }
    
    .pagefind-ui .pagefind-ui__result-excerpt {
      line-height: 1.6;
    }
  </style>
</BaseLayout>
