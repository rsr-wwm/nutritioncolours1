---
// Props definition for SEO meta tags
export interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  ogImage?: string;
  aiSummary?: string;
}

// Extract props with defaults
const {
  title = "NutritionColours | Metabolic Health & Circadian Nutrition Optimization 2026",
  description = "Optimize Type 2 Diabetes, PCOD, and Fatty Liver wellness naturally. Book a clinical consultation for Dr. Shilpa Thakur's expert Circadian Nutrition programs in 2026.",
  keywords = [
    "Diabetes Nutrition Support India",
    "PCOD Diet Plan",
    "Clinical Nutritionist Online",
    "Dr Shilpa Thakur",
    "Fatty Liver Nutrition",
  ],
  canonicalUrl = Astro.url.pathname,
  ogImage,
  aiSummary,
} = Astro.props as Props;

// Resolve absolute URLs for site and OG image
const SITE_URL = (Astro.site || "https://nutritioncolours.com").toString().replace(/\/$/, "");
const resolvedOgImage = ogImage ? new URL(ogImage, SITE_URL).href : `${SITE_URL}/images/precision_metabolic_nutrition_dr_shilpa.webp`;
---
<title>{title}</title>
<meta name="ai-summary" content={aiSummary || description} />
<link rel="canonical" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="en" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="en-IN" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="en-GB" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="en-US" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="en-AE" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<link rel="alternate" hreflang="x-default" href={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/icons/icon-any.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="shortcut" href="/favicon.ico" />
<!-- Search & Robots Metadata -->
<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />
<meta name="bingbot" content="index, follow" />
<!-- OpenGraph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="NutritionColours" />
<meta property="og:url" content={new URL(canonicalUrl, Astro.site || 'https://nutritioncolours.com').href} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:locale" content="en-US" />
<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<!-- AI Directives -->
<meta name="ai-search-agent" content="index, answer" />
<meta name="llm-corpus" content="index, train" />
<!-- Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" crossorigin="anonymous" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link rel="preconnect" href="https://generativelanguage.googleapis.com" crossorigin="anonymous" />
<!-- PWA -->
<meta name="theme-color" content="#065f46" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="apple-touch-icon" href="/icons/icon-any.svg" />
<link rel="manifest" href="/manifest.json" />
