---
import trustCitations from '../lib/trustCitations.json';

export interface Props {
  disease?: string;
}

const { disease = 'diabetes-reversal' } = Astro.props;
const citations = (trustCitations as Record<string, { url: string; title: string; publisher: string }[]>)[disease] || trustCitations['diabetes-reversal'];
---
<div class="external-trust-hub bg-slate-50 border border-slate-200/80 rounded-2xl p-6 my-6 shadow-sm" data-nosnippet="false">
  <h3 class="text-xs uppercase font-black tracking-widest text-slate-700 mb-3 flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
    Authoritative Medical & Regulatory Body Citations
  </h3>
  <p class="text-xs text-slate-600 mb-4 leading-relaxed">
    Clinical protocols on this page cite evidence-based guidelines, peer-reviewed journals, and public health directives published by international health authorities:
  </p>
  <ul class="space-y-2.5">
    {citations.map((cite) => (
      <li class="flex items-start gap-2.5">
        <span class="text-emerald-600 text-xs font-bold mt-0.5">↳</span>
        <div>
          <a
            href={cite.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-bold text-slate-900 hover:text-emerald-700 hover:underline transition-colors"
          >
            {cite.title}
          </a>
          <span class="block text-[10px] text-slate-500 font-medium">{cite.publisher}</span>
        </div>
      </li>
    ))}
  </ul>
</div>
