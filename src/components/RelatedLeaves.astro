---
import { leafMap, type LeafEntry } from '../lib/leafMap';
import ExternalCitations from './ExternalCitations.astro';

export interface Props {
  disease?: string;
  formula?: '1+4' | '1+3' | '1-2';
}

const { disease = 'diabetes-reversal', formula = '1+3' } = Astro.props;
const leaves: LeafEntry[] = leafMap[disease] || leafMap['diabetes-reversal'] || [];

const count = formula === '1+4' ? 4 : formula === '1+3' ? 3 : 0;
const visibleLeaves = leaves.slice(0, count);
---
<div class="related-leaves-container my-8">
  {visibleLeaves.length > 0 && (
    <div class="mb-6">
      <h3 class="text-xs uppercase font-black tracking-widest text-emerald-900 mb-3 flex items-center gap-2">
        <span>🌿</span> Related Clinical Leaf Protocols & Swaps
      </h3>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {visibleLeaves.map((leaf) => (
          <a
            href={`/topic/${leaf.slug}`}
            class="block bg-white p-4 rounded-xl border border-emerald-100/80 hover:border-emerald-300 shadow-sm hover:shadow-md transition-all group"
            data-nosnippet="true"
          >
            <span class="text-xs font-bold text-emerald-950 group-hover:text-emerald-700 transition-colors block mb-1">
              {leaf.title}
            </span>
            <span class="text-[10px] text-emerald-600 font-semibold flex items-center gap-1">
              Explore Protocol <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  )}

  <ExternalCitations disease={disease} />
</div>
