---
interface Props {
  items: { href: string; label: string }[];
  variant?: 'mobile' | 'desktop';
}
const { items, variant = 'desktop' } = Astro.props;
---
{variant === 'mobile' ? (
  <ul class="mt-3 grid gap-2 text-sm sm:grid-cols-2">
    {items.map((item) => (
      <li>
        <a href={item.href} class="flex items-center gap-2 font-semibold text-emerald-800 dark:text-emerald-300 hover:text-emerald-950 dark:hover:text-emerald-100 hover:underline py-1 transition-colors">
          <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-600 dark:bg-emerald-400" aria-hidden="true"></span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <ul class="mt-4 space-y-1.5 text-sm">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          class="group flex items-center justify-between py-1.5 px-3 rounded-xl text-stone-700 dark:text-stone-300 hover:text-emerald-950 dark:hover:text-emerald-200 hover:bg-emerald-50/70 dark:hover:bg-emerald-950/40 border-l-2 border-transparent hover:border-emerald-600 dark:hover:border-emerald-400 transition-all duration-200"
        >
          <span class="group-hover:translate-x-0.5 transition-transform duration-200 ease-out">{item.label}</span>
          <span class="text-xs text-emerald-600 dark:text-emerald-400 opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">&rarr;</span>
        </a>
      </li>
    ))}
  </ul>
)}
