---
interface Props {
  current: string;
}

const { current } = Astro.props;

const legalTabs = [
  { href: '/legal/editorial-policy', label: 'Editorial policy' },
  { href: '/legal/methodology', label: 'Methodology' },
  { href: '/legal/privacy', label: 'Privacy notice' },
  { href: '/legal/terms', label: 'Terms of use' },
];
---

<nav aria-label="Legal policies navigation" class="mt-8 flex flex-wrap gap-2 border-b border-stone-200 dark:border-stone-800 pb-4">
  {legalTabs.map((tab) => (
    <a
      href={tab.href}
      class:list={[
        'inline-flex min-h-11 items-center rounded-xl px-4 py-2 text-sm font-bold transition-colors',
        tab.href === current
          ? 'bg-emerald-900 text-white dark:bg-emerald-700'
          : 'text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-emerald-900 dark:hover:text-emerald-300'
      ]}
      aria-current={tab.href === current ? 'page' : undefined}
    >
      {tab.label}
    </a>
  ))}
</nav>
