---
/**
 * SeoHelper.astro – Centralised SEO <head> injector
 *
 * Renders standard metadata, canonical and language links, social previews,
 * crawler directives, favicons, and safely serialized JSON-LD.
 */
import JsonLd from './JsonLd.astro';

export interface Props {
  title?:        string;
  description?:  string;
  keywords?:     string[];
  canonicalUrl?: string;
  ogImage?:      string;
  aiSummary?:    string;
  geoRegion?:    string;
  geoPlacename?: string;
  disease?:      string;
  schemas?:      any[];
  noindex?:      boolean;
  ogType?:       'website' | 'article';
  breadcrumbs?:  Array<{ name: string; path: string }>;
}

const {
  title       = "NutritionColours — Food and nutrition education",
  description = "Food and recipe directories, publication policies, and transparent review-status notices.",
  keywords    = ["food education", "nutrition education", "recipes"],
  canonicalUrl = Astro.url.pathname,
  ogImage,
  aiSummary,
  geoRegion,
  geoPlacename,
  disease,
  schemas     = [],
  noindex     = false,
  ogType      = 'website',
  breadcrumbs,
} = Astro.props as Props;

const SITE_URL       = (Astro.site ?? "https://nutritioncolours.com").toString().replace(/\/$/, "");
const rawPath        = canonicalUrl.replace(/\/$/, "");
const canonicalCandidate = new URL(rawPath || "/", SITE_URL);
if (canonicalCandidate.origin !== SITE_URL) throw new Error(`Canonical URL must remain same-origin: ${canonicalUrl}`);
const resolvedCanon  = canonicalCandidate.href;
const resolvedOgImg  = ogImage
  ? new URL(ogImage, SITE_URL).href
  : `${SITE_URL}/images/nutritioncolours-default.svg`;
void aiSummary;
void keywords;

// Prefer caller-supplied labels so visible navigation and structured data agree.
const segments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbEntries = breadcrumbs?.length ? breadcrumbs : [
  { name: 'Home', path: '/' },
  ...segments.map((seg, idx) => ({
    name: seg.replace(/-/g, " ").replace(/\b\w/g, c => c.toUpperCase()),
    path: `/${segments.slice(0, idx + 1).join("/")}`,
  })),
];
const breadcrumbItems = breadcrumbEntries.map((entry, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    name: entry.name,
    item: (() => {
      const itemUrl = new URL(entry.path, SITE_URL);
      if (itemUrl.origin !== SITE_URL) throw new Error(`Breadcrumb URL must remain same-origin: ${entry.path}`);
      return itemUrl.href;
    })(),
}));
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems,
};

void disease;
const finalSchemas = [breadcrumbSchema, ...schemas].filter(Boolean);
---

<!-- Primary Meta -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanon} />

{geoRegion && <meta name="geo.region" content={geoRegion} />}
{geoPlacename && <meta name="geo.placename" content={geoPlacename} />}

<!-- Hreflang: properly scoped for a single-language global site -->
<link rel="alternate" hreflang="en" href={resolvedCanon} />
<link rel="alternate" hreflang="x-default" href={resolvedCanon} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/icons/icon-any.svg" />

<!-- Robots -->
<meta name="robots" content={`${noindex ? 'noindex' : 'index'}, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1`} />
<meta name="googlebot" content={`${noindex ? 'noindex' : 'index'}, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1`} />
<meta name="bingbot" content={`${noindex ? 'noindex' : 'index'}, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1`} />

<!-- OpenGraph -->
<meta property="og:type"        content={ogType} />
<meta property="og:title"       content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name"   content="NutritionColours" />
<meta property="og:url"         content={resolvedCanon} />
<meta property="og:image"       content={resolvedOgImg} />
<meta property="og:image:alt"   content={title} />
<meta property="og:locale"      content="en_US" />

<!-- Twitter / X Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={resolvedOgImg} />

<!-- PWA / App meta -->
<meta name="theme-color"                        content="#065f46" />
<meta name="mobile-web-app-capable"             content="yes" />
<meta name="apple-mobile-web-app-capable"       content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<link rel="manifest"         href="/manifest.json" />

<!-- Preconnect to critical origins -->
<!-- JSON-LD (page-level; Org+Site graph lives in BaseLayout) -->
{finalSchemas.map(schema => (
  <JsonLd data={schema} />
))}
