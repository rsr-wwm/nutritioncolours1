---
interface Props {
  name: 'leaf-branch' | 'sun-moon' | 'flask-leaf' | 'divider-flourish' | 'fibonacci-spiral' | 'cellular-network' | 'deterministic-watermark';
  class?: string;
  size?: number | string;
  seed?: string;
}

const { name, class: className = '', size, seed = 'nutritioncolours' } = Astro.props;
const dimensionStyle = size ? `width: ${typeof size === 'number' ? `${size}px` : size}; height: ${typeof size === 'number' ? `${size}px` : size};` : undefined;

// Deterministic seed hashing for procedural plant geometry
function hashSeed(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    hash = (hash << 5) - hash + str.charCodeAt(i);
    hash |= 0;
  }
  return Math.abs(hash);
}

const seedNum = hashSeed(seed);
const rot = (seedNum % 24) - 12; // -12deg to +12deg tilt
const curvature = 20 + (seedNum % 15); // Dynamic curve control point
---

