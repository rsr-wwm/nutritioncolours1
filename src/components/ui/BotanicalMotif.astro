    viewBox="0 0 48 48"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class:list={['inline-block shrink-0', className]}
    style={dimensionStyle}
    aria-hidden="true"
  >
    <path
      d="M8 40C16 36 28 26 38 10"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    />
