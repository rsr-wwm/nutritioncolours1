---
import Header from '../components/ui/Header.astro';
import Footer from './Footer.astro';
import SeoHelper from '../components/SeoHelper.astro';
import JsonLd from '../components/JsonLd.astro';

import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[]; // hybrid support


  canonicalUrl?: string;
  ogImage?: string;
  aiSummary?: string;
  geoRegion?: string;
  geoPlacename?: string;
  disease?: string;
  schemas?: any[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  breadcrumbs?: Array<{ name: string; path: string }>;
  pageCategory?: 'clinical' | 'knowledge' | 'recipe' | 'tool';
}

const {
  title = "NutritionColours — Food and nutrition education",
  description = "Food and recipe directories, publication policies, and transparent review-status notices.",
  keywords = ["food education", "nutrition education", "recipes", "nutrition glossary"],
  canonicalUrl = Astro.url.pathname,
  ogImage,
  aiSummary,
  geoRegion,
  geoPlacename,
  disease,
  schemas = [],
  noindex = false,
  ogType = 'website',
  breadcrumbs,
  pageCategory,
} = Astro.props;

// Site-wide entity graph. Keep this intentionally minimal: identity and credential
// fields are added only after they are backed by a verified registry record.
const SITE_URL = (Astro.site || 'https://nutritioncolours.com').toString().replace(/\/$/, '');
const resolvedOgImage = ogImage
  ? new URL(ogImage, SITE_URL).href
  // Shared social card keeps its wordmark clear at small preview sizes.
  : `${SITE_URL}/images/nutritioncolours-social.png`;
if (new URL(resolvedOgImage).origin !== SITE_URL) {
  throw new Error(`Open Graph image must remain same-origin: ${ogImage}`);
}
const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      "name": "NutritionColours",
      "url": SITE_URL,
      // Google's logo structured-data guidelines only support JPG/PNG/WEBP — SVG is
      // explicitly not recognized, which would make this Organization ineligible for
      // a logo in Search/Knowledge Panel results.
      "logo": `${SITE_URL}/images/nutritioncolours-logo.png`,
      "description": "Nutrition and food education resources for general informational use.",
    },
    {
      // No `potentialAction`/SearchAction here deliberately — the site has no real
      // search endpoint today. Adding one would describe a feature that doesn't exist.
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": SITE_URL,
      "name": "NutritionColours",
      "description": "Nutrition and food education resources for general informational use.",
      "publisher": { "@id": `${SITE_URL}/#organization` },
      "inLanguage": "en",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="en" data-page-category={pageCategory}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-latin-900-normal.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('nc-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
    
    <SeoHelper title={title} description={description} keywords={keywords} canonicalUrl={canonicalUrl} ogImage={resolvedOgImage} aiSummary={aiSummary} geoRegion={geoRegion} geoPlacename={geoPlacename} disease={disease} schemas={schemas} noindex={noindex} ogType={ogType} breadcrumbs={breadcrumbs} />

    <link rel="alternate" type="text/markdown" href="/llms.txt" title="NutritionColours site guide" />

    {/* Site-wide identity graph. Credentials are intentionally omitted until verified. */}
    <JsonLd data={organizationSchema} />

    <script src="../scripts/theme.ts"></script>
  </head>
  <body class="bg-surface-base text-text-primary selection:bg-emerald-800 selection:text-white font-sans transition-colors duration-300" data-page-title={title}>
    <a href="#main-content" class="skip-nav sr-only focus:not-sr-only">
      Skip to main content
    </a>
    


    {/* Static Astro navigation: identical HTML for readers, crawlers, and assistive technology. */}
    <Header />

    <main id="main-content" data-pagefind-body={noindex ? undefined : true}>
      <slot />
    </main>

    <Footer />

  </body>
</html>
